@page "{id}"
@model Rroms.Web.Areas.Admin.Pages.Accounts.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <a asp-page="Edit" asp-route-id="@Model.Id" class="d-inline-block mb-3">&larr; Back to account</a>

        <section class="tg-card" aria-labelledby="reset-heading">
            <h1 id="reset-heading" class="h3 mb-1">Reset password</h1>
            <p class="text-secondary mb-4">For <strong>@Model.Account.FullName</strong> (@Model.Account.Email). Any lockout is cleared and they are signed out elsewhere.</p>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Input.NewPassword" class="form-label fw-semibold"></label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">Set new password</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
