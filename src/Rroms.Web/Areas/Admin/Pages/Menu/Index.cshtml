@page
@model IndexModel
@using Rroms.Web.Common
@using Rroms.Web.Models
@using Rroms.Web.Services
@{
	ViewData["Title"] = "Menu items";
}

<style>
	.am-tile { width: 56px; height: 56px; border-radius: 12px; display: grid; place-items: center; color: #fff;
		font: 400 1.5rem "Playfair Display", Georgia, serif; background: linear-gradient(135deg, #3a2c1e, #8a6424); }
	.am-was { text-decoration: line-through; color: #6c757d; margin-right: .25rem; }
	.am-switch { display: inline-flex; align-items: center; gap: .5rem; border: 0; background: none; padding: 0; font-weight: 600; cursor: pointer; }
	.am-track { width: 40px; height: 22px; border-radius: 99px; background: #adb5bd; position: relative; display: inline-block; transition: background .15s; }
	.am-track::after { content: ""; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: left .15s; }
	.am-switch[aria-checked="true"] .am-track { background: #0f7b6c; }
	.am-switch[aria-checked="true"] .am-track::after { left: 21px; }
	.am-bin { width: 36px; height: 36px; padding: 0; border-radius: 50%; line-height: 1; }
	.am-dialog { border: 0; border-radius: 18px; padding: 1.5rem; max-width: 440px; width: 92vw; box-shadow: 0 10px 40px rgba(0,0,0,.3); }
	.am-dialog::backdrop { background: rgba(30, 15, 30, .45); }
</style>

<section class="hero hero-compact mb-4" aria-labelledby="menu-heading">
	<span class="hero-bubble one" aria-hidden="true"></span>
	<div class="position-relative">
		<span class="eyebrow">Menu</span>
		<h1 id="menu-heading" class="mb-1">Menu items</h1>
		<p class="lead mb-0">Dishes, prices, availability and photos.</p>
	</div>
</section>

<div class="am-layout">
	@* Left rail: the same GET filter as before (q, categoryId, status). Categories and status are radio buttons
	   with the same names and values as the old drop-downs, so the page model reads them exactly the same way. *@
	<div class="am-rail">
	<form method="get" id="menuFilter" aria-label="Filter dishes">
		<label for="searchBox" class="visually-hidden">Search</label>
		<input id="searchBox" name="q" type="search" class="form-control am-search" placeholder="Name or code" value="@Model.Search" />

		<fieldset class="mt-4">
			<legend class="am-label">Category</legend>
			<input type="radio" class="btn-check" name="categoryId" id="cat-all" value="" checked="@(Model.CategoryId == null)" />
			<label class="am-cat" for="cat-all">All categories</label>
			@foreach (MenuCategory category in Model.Categories)
			{
				<input type="radio" class="btn-check" name="categoryId" id="cat-@category.Id" value="@category.Id" checked="@(category.Id == Model.CategoryId)" />
				<label class="am-cat" for="cat-@category.Id">@category.Name@(category.IsActive ? "" : " (hidden)")</label>
			}
		</fieldset>

		<fieldset class="mt-4">
			<legend class="am-label">Status</legend>
			<div class="am-seg">
				<input type="radio" class="btn-check" name="status" id="status-any" value="" checked="@(Model.Status != IndexModel.StatusAvailable && Model.Status != IndexModel.StatusUnavailable)" />
				<label for="status-any">Any</label>
				<input type="radio" class="btn-check" name="status" id="status-on" value="available" checked="@(Model.Status == IndexModel.StatusAvailable)" />
				<label for="status-on">Available</label>
				<input type="radio" class="btn-check" name="status" id="status-off" value="unavailable" checked="@(Model.Status == IndexModel.StatusUnavailable)" />
				<label for="status-off">Off</label>
			</div>
		</fieldset>

		@* Filters apply as soon as they change (script below); the button is only needed without JavaScript. *@
		<noscript><button type="submit" class="btn btn-outline-primary btn-sm mt-4">Filter</button></noscript>
	</form>

	@* Dietary tags (YY-8a), moved here from its own dashboard tile: a separate form, so it is not part of the filters. *@
	<section class="am-tags mt-4" aria-labelledby="tags-heading">
		<h2 id="tags-heading" class="am-label">Dietary tags</h2>
		<ul class="am-tag-list" aria-label="Current dietary tags">
			@foreach (DietaryTag tag in Model.Tags)
			{
				<li>@tag.Name</li>
			}
		</ul>
		<form method="post" asp-page-handler="AddTag" asp-route-categoryId="@Model.CategoryId" asp-route-q="@Model.Search" asp-route-status="@Model.Status" class="am-tag-add">
			<label for="newTagName" class="visually-hidden">New tag name</label>
			<input id="newTagName" name="newTagName" class="form-control form-control-sm" maxlength="@DietaryTag.NameMaxLength" placeholder="New tag, e.g. Nuts" required />
			<button type="submit" class="btn btn-outline-primary btn-sm">Add</button>
		</form>
		<p class="am-note mt-2 mb-0">Customers tick the tags they avoid on their profile. Tags can't be deleted.</p>
	</section>
	</div>
	<script>
		(function () {
			var form = document.getElementById('menuFilter');
			var search = document.getElementById('searchBox');
			var timer = null;

			// Category and status: reload the list straight away.
			form.querySelectorAll('input[type="radio"]').forEach(function (radio) {
				radio.addEventListener('change', function () { form.submit(); });
			});

			// Search: reload once typing pauses, and put the cursor back in the box afterwards.
			search.addEventListener('input', function () {
				clearTimeout(timer);
				timer = setTimeout(function () {
					try { sessionStorage.setItem('menuSearchFocus', '1'); } catch (e) { }
					form.submit();
				}, 600);
			});
			try {
				if (sessionStorage.getItem('menuSearchFocus') === '1') {
					sessionStorage.removeItem('menuSearchFocus');
					search.focus();
					search.setSelectionRange(search.value.length, search.value.length);
				}
			} catch (e) { }
		})();
	</script>

	<section class="am-list" aria-labelledby="list-heading">
		<h2 id="list-heading" class="h4 mb-3">
			All dishes (@Model.Items.Count)
			<small class="am-note">
				@if (Model.IsFiltered)
				{
					<text>of @Model.TotalCount &middot; </text>
				}
				price shown is what customers pay now; offers come from Promotions
			</small>
		</h2>

		@if (Model.TotalCount == 0)
		{
			<p class="text-secondary">No dishes yet. Use "Add a dish" to create the first one.</p>
		}
		else if (Model.Items.Count == 0)
		{
			<p class="text-secondary">No dishes match your search. <a asp-page="/Menu/Index">Clear the filters</a>.</p>
		}

		<div class="am-grid">
			<a class="am-add" asp-page="/Menu/Edit"><span class="am-plus" aria-hidden="true">+</span>Add a dish</a>

			@if (Model.Items.Count > 0)
			{
				<table class="table align-middle">
					<thead>
						<tr>
							<th scope="col"><span class="visually-hidden">Photo</span></th>
							<th scope="col">Code</th>
							<th scope="col">Dish</th>
							<th scope="col">Category</th>
							<th scope="col">Price now (RM)</th>
							<th scope="col">Status</th>
							<th scope="col"><span class="visually-hidden">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						@foreach (MenuItem item in Model.Items)
						{
							string? photoUrl = Model.GetPhotoUrl(item);
							PriceQuote quote = Model.GetQuote(item);

							<tr>
								<td>
									@if (photoUrl != null)
									{
										<img src="@photoUrl" alt="Photo of @item.Name" width="56" height="56" class="rounded" style="object-fit: cover;" />
									}
									else
									{
										<div class="am-tile" aria-hidden="true">@Model.GetLetter(item)</div>
									}
								</td>
								<td>@item.Code</td>
								<th scope="row">@item.Name</th>
								<td>@item.MenuCategory?.Name</td>
								<td>
									@if (quote.IsOffer)
									{
										<span class="am-was">@item.Price.ToString("N2")</span>
										<strong>@quote.Price.ToString("N2")</strong>
										<span class="badge text-bg-warning" title="@(quote.Label ?? quote.Note)">@quote.Badge</span>
									}
									else
									{
										@item.Price.ToString("N2")
									}
								</td>
								<td>
									<form method="post" asp-page-handler="Toggle" asp-route-id="@item.Id" asp-route-categoryId="@Model.CategoryId" asp-route-q="@Model.Search" asp-route-status="@Model.Status" class="d-inline">
										<input type="hidden" name="makeAvailable" value="@(item.IsAvailable ? "false" : "true")" />
										<button type="submit" class="am-switch" role="switch" aria-checked="@(item.IsAvailable ? "true" : "false")"
												title="@(item.IsAvailable ? "Click to stop ordering this dish" : "Click to allow ordering this dish")">
											<span class="am-track" aria-hidden="true"></span>
											<span>@(item.IsAvailable ? "Available" : "Unavailable")</span>
										</button>
									</form>
								</td>
								<td class="text-end text-nowrap">
									<a class="btn btn-sm btn-outline-primary" asp-page="/Menu/Edit" asp-route-id="@item.Id">Edit</a>

									<form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" asp-route-categoryId="@Model.CategoryId" asp-route-q="@Model.Search" asp-route-status="@Model.Status"
										  class="d-inline js-delete-form" data-dish="@item.Name">
										<button type="submit" class="btn btn-outline-danger am-bin" title="Delete" aria-label="Delete @item.Name">&#128465;</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</section>
</div>

<dialog id="deleteDialog" class="am-dialog" aria-labelledby="deleteTitle">
	<h2 id="deleteTitle" class="h4 mb-2">Delete this dish?</h2>
	<p class="text-secondary mb-3">
		This removes <strong id="deleteName"></strong> from the menu, with its photo. This cannot be undone.
		A dish that customers have already ordered cannot be deleted: mark it unavailable instead.
	</p>
	<div class="text-end">
		<button type="button" id="deleteCancel" class="btn btn-outline-primary">Keep it</button>
		<button type="button" id="deleteConfirm" class="btn btn-danger">Yes, delete</button>
	</div>
</dialog>

<script>
	(function () {
		var dialog = document.getElementById('deleteDialog');
		if (!dialog || typeof dialog.showModal !== 'function') { return; }

		var pending = null;
		var forms = document.querySelectorAll('.js-delete-form');

		forms.forEach(function (form) {
			form.addEventListener('submit', function (event) {
				if (form.dataset.confirmed === 'yes') { return; }
				event.preventDefault();
				pending = form;
				document.getElementById('deleteName').textContent = form.dataset.dish || 'this dish';
				dialog.showModal();
			});
		});

		document.getElementById('deleteCancel').addEventListener('click', function () {
			pending = null;
			dialog.close();
		});

		document.getElementById('deleteConfirm').addEventListener('click', function () {
			if (pending) {
				pending.dataset.confirmed = 'yes';
				pending.requestSubmit();
			}
			dialog.close();
		});
	})();
</script>
