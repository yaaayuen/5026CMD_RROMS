@page
@model IndexModel
@using Rroms.Web.Models
@{
	ViewData["Title"] = "Menu items";
}

<section class="hero hero-compact mb-4" aria-labelledby="menu-heading">
	<span class="hero-bubble one" aria-hidden="true"></span>
	<div class="position-relative">
		<span class="eyebrow">Menu</span>
		<h1 id="menu-heading" class="mb-1">Menu items</h1>
		<p class="lead mb-0">Dishes, prices, availability, offers and photos.</p>
	</div>
</section>

<section class="tg-card h-auto" aria-labelledby="list-heading">
	<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
		<h2 id="list-heading" class="h4 mb-0">All dishes</h2>

		<div class="d-flex flex-wrap align-items-end gap-3">
			<form method="get" class="d-flex align-items-end gap-2">
				<div>
					<label for="categoryFilter" class="form-label fw-semibold mb-1">Category</label>
					<select id="categoryFilter" name="categoryId" class="form-select">
						<option value="">All categories</option>
						@foreach (MenuCategory category in Model.Categories)
						{
							<option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name@(category.IsActive ? "" : " (hidden)")</option>
						}
					</select>
				</div>
				<button type="submit" class="btn btn-outline-primary">Filter</button>
			</form>

			<a class="btn btn-primary" asp-page="/Menu/Edit">Add a dish</a>
		</div>
	</div>

	@if (Model.Items.Count == 0)
	{
		<p class="text-secondary mb-0">No dishes yet. Use "Add a dish" to create the first one.</p>
	}
	else
	{
		<div class="table-responsive">
			<table class="table align-middle">
				<thead>
					<tr>
						<th scope="col"><span class="visually-hidden">Photo</span></th>
						<th scope="col">Code</th>
						<th scope="col">Dish</th>
						<th scope="col">Category</th>
						<th scope="col">Price (RM)</th>
						<th scope="col">Status</th>
						<th scope="col"><span class="visually-hidden">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					@foreach (MenuItem item in Model.Items)
					{
						string? photoUrl = Model.GetPhotoUrl(item);
						bool offerActive = Model.IsOfferActive(item);

						<tr>
							<td>
								@if (photoUrl != null)
								{
									<img src="@photoUrl" alt="Photo of @item.Name" width="64" height="64" class="rounded" style="object-fit: cover;" />
								}
							</td>
							<td>@item.Code</td>
							<th scope="row">@item.Name</th>
							<td>@item.MenuCategory?.Name</td>
							<td>
								@if (offerActive)
								{
									<span class="text-decoration-line-through text-secondary">@item.Price.ToString("N2")</span>
									<strong>@Model.GetCurrentPrice(item).ToString("N2")</strong>
									<span class="badge text-bg-warning">Offer</span>
								}
								else
								{
									@item.Price.ToString("N2")
								}
							</td>
							<td>
								@if (item.IsAvailable)
								{
									<span class="badge text-bg-success">Available</span>
								}
								else
								{
									<span class="badge text-bg-secondary">Unavailable</span>
								}
							</td>
							<td class="text-end text-nowrap">
								<a class="btn btn-sm btn-outline-primary" asp-page="/Menu/Edit" asp-route-id="@item.Id">Edit</a>

								<form method="post" asp-page-handler="Toggle" asp-route-id="@item.Id" asp-route-categoryId="@Model.CategoryId" class="d-inline">
									<input type="hidden" name="makeAvailable" value="@(item.IsAvailable ? "false" : "true")" />
									<button type="submit" class="btn btn-sm btn-outline-secondary">@(item.IsAvailable ? "Mark unavailable" : "Mark available")</button>
								</form>

								<form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" asp-route-categoryId="@Model.CategoryId" class="d-inline"
									  onsubmit="return confirm('Delete this dish? This cannot be undone.');">
									<button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</section>
