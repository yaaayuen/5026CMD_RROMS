@page
@model StaffDeskModel
@{
    ViewData["Title"] = "Staff desk";
}

<p class="mb-3"><a asp-page="/Index">&larr; Admin dashboard</a></p>

<section class="hero hero-compact hero-photo mb-4" aria-labelledby="staff-desk-heading">
    <span class="hero-bubble one" aria-hidden="true"></span>
    <div class="position-relative">
        <span class="eyebrow">Administrator</span>
        <h1 id="staff-desk-heading" class="mb-2">Staff desk</h1>
        <p class="lead mb-0">The staff pages for today's service: bookings, the kitchen and the bills.</p>
    </div>
</section>

<div class="row g-4">
    @foreach (ModuleTileViewModel tile in Model.Tiles)
    {
        <div class="col-sm-6 col-lg-4">
            <partial name="_ModuleTile" model="tile" />
            @if (tile.Url == "/Staff/Billing") { <span class="badge text-bg-warning mt-2">@Model.UnpaidBills unpaid bills</span> }
        </div>
    }
</div>
