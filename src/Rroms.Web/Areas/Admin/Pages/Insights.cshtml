@page
@model InsightsModel
@{
    ViewData["Title"] = "Insights and reports";
}

<p class="mb-3"><a asp-page="/Index">&larr; Admin dashboard</a></p>

<section class="hero hero-compact hero-photo mb-4" aria-labelledby="insights-heading">
    <span class="hero-bubble one" aria-hidden="true"></span>
    <div class="position-relative">
        <span class="eyebrow">Administrator</span>
        <h1 id="insights-heading" class="mb-2">Insights and reports</h1>
        <p class="lead mb-0">See how the business is doing: figures, charts and records.</p>
    </div>
</section>

<div class="row g-4">
    @foreach (ModuleTileViewModel tile in Model.Tiles)
    {
        <div class="col-sm-6 col-lg-4">
            <partial name="_ModuleTile" model="tile" />
        </div>
    }
</div>
