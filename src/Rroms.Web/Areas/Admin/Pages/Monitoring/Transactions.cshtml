@page
@model Rroms.Web.Areas.Admin.Pages.Monitoring.TransactionsModel
@using Rroms.Web.Common
@using Rroms.Web.Contracts
@{ ViewData["Title"] = "Monitor transactions"; }
<section class="hero hero-compact mb-4" aria-labelledby="monitor-transactions-heading">
    <span class="hero-bubble one" aria-hidden="true"></span>
    <div class="position-relative">
        <span class="eyebrow">Administrator · Monitoring</span>
        <h1 id="monitor-transactions-heading" class="mb-1">Monitor transactions</h1>
        <p class="lead mb-0">Filter by payment recording date. Both dates are inclusive, in Malaysia time (UTC+8). Refresh to see updates.</p>
    </div>
</section>
<partial name="_MonitoringNav" />
<p><a asp-area="Staff" asp-page="/Billing/Refunds">View all refund requests and records</a></p>
<div class="tg-card p-4 mb-4"><form method="get" class="row g-3 align-items-end">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="col-md-3"><label asp-for="Filter.From" class="form-label">From date</label><input asp-for="Filter.From" asp-format="{0:yyyy-MM-dd}" type="date" required class="form-control" /></div>
<div class="col-md-3"><label asp-for="Filter.To" class="form-label">To date</label><input asp-for="Filter.To" asp-format="{0:yyyy-MM-dd}" type="date" required class="form-control" /></div>
<div class="col-md-3"><label asp-for="Filter.Status" class="form-label">Status</label><select asp-for="Filter.Status" asp-items="Html.GetEnumSelectList<PaymentStatus>()" class="form-select"><option value="">All statuses</option></select></div>
<div class="col-md-3"><label asp-for="Filter.Method" class="form-label">Payment method</label>
<select asp-for="Filter.Method" class="form-select"><option value="">All methods</option>
<option value="Cash">Cash</option><option value="CardTerminal">Card terminal</option><option value="EWallet">E-wallet</option>
</select></div>
<div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary">Apply filters</button><a asp-page="Transactions" class="btn btn-outline-secondary">Today / Reset</a></div>
</form></div>
@if (Model.Loaded)
{
    <p><strong>@Model.Results.Count payment record(s)</strong></p>
<div class="tg-card p-3 mb-3"><p>Paid total: <strong>RM @Model.Results.PaidTotal.ToString("N2")</strong></p>
<p class="mb-0">These are gross payment totals before refunds. See Reports → Sales for refunds and net totals. Only matching Paid records contribute to totals. Unpaid/Voided records do not. This list contains recorded transactions; orders without a payment record are not listed.</p></div>
    @if (Model.Results.Count == 0) { <div class="tg-card p-4">No transactions match these filters.</div> }
    else
    {
        <div class="tg-card p-3 table-responsive"><table class="table align-middle"><caption>All matching transactions, newest first. Totals cover these results.</caption>
        <thead><tr><th>Payment / order</th><th>Customer / recorded by</th><th>Recorded (Malaysia)</th><th>Method</th><th>Status</th><th>Amount (RM)</th><th>Links</th></tr></thead><tbody>
        @foreach (var row in Model.Results.Rows)
        {
            <tr><td>#@row.Id / #@row.OrderId</td><td>@row.CustomerName<br />Recorded by: @row.StaffName</td><td>@MalaysiaTime.FromUtc(row.PaidAtUtc).ToString("dd MMM yyyy HH:mm")</td>
<td>@Money.Method(row.Method) @if (row.Method == PaymentMethod.SimulatedOnline) { <span class="badge text-bg-warning">Demo — no real payment processed</span> }</td>
<td><span class="tg-status @(row.Status switch { PaymentStatus.Paid => "is-confirmed", PaymentStatus.Voided => "is-cancelled", _ => "is-pending" })">@row.Status</span> @if(row.RefundStatus.HasValue) { <small class="d-block">Refund: @row.RefundStatus</small> } @if(row.Status == PaymentStatus.Voided) { <small class="d-block">@row.VoidReason</small><small class="d-block">By: @row.VoidedById</small>@if(row.VoidedAtUtc.HasValue) { <small class="d-block">@MalaysiaTime.FromUtc(row.VoidedAtUtc.Value).ToString("dd MMM yyyy HH:mm")</small> } }</td><td>@row.Amount.ToString("N2")</td><td>
@if (row.Status == PaymentStatus.Paid || row.Status == PaymentStatus.Voided) { <a asp-area="Staff" asp-page="/Billing/Receipt" asp-route-id="@row.Id">Receipt</a><br /> }
<a asp-area="Staff" asp-page="/Billing/Details" asp-route-id="@row.OrderId">Order / bill details</a></td></tr>
        }
        </tbody></table></div>
    }
}
