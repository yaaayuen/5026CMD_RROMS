@page
@model Rroms.Web.Areas.Admin.Pages.Monitoring.TransactionsModel
@using Rroms.Web.Common
@using Rroms.Web.Contracts
@{ ViewData["Title"] = "Monitor transactions"; }
<div class="hero mb-4"><h1>Monitor transactions</h1><p>Filter by payment recording date. Both dates are inclusive, in Malaysia time (UTC+8). Refresh to see updates.</p></div>
<partial name="_MonitoringNav" />
<div class="tg-card p-4 mb-4"><form method="get" class="row g-3 align-items-end">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="col-md-3"><label asp-for="Filter.From" class="form-label">From date</label><input asp-for="Filter.From" asp-format="{0:yyyy-MM-dd}" type="date" required class="form-control" /></div>
<div class="col-md-3"><label asp-for="Filter.To" class="form-label">To date</label><input asp-for="Filter.To" asp-format="{0:yyyy-MM-dd}" type="date" required class="form-control" /></div>
<div class="col-md-3"><label asp-for="Filter.Status" class="form-label">Status</label><select asp-for="Filter.Status" asp-items="Html.GetEnumSelectList<PaymentStatus>()" class="form-select"><option value="">All statuses</option></select></div>
<div class="col-md-3"><label asp-for="Filter.Method" class="form-label">Payment method</label>
<select asp-for="Filter.Method" class="form-select"><option value="">All methods</option>
<option value="Cash">Cash</option><option value="CardTerminal">Card terminal</option><option value="EWallet">E-wallet</option><option value="SimulatedOnline">Simulated online (demo)</option>
</select></div>
<div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary">Apply filters</button><a asp-page="Transactions" class="btn btn-outline-secondary">Today / Reset</a></div>
</form></div>
@if (Model.Loaded)
{
    <p><strong>@Model.Results.Count payment record(s)</strong></p>
<div class="tg-card p-3 mb-3"><p>Paid total, including demo: <strong>RM @Model.Results.PaidTotal.ToString("N2")</strong></p>
<p>Non-demo Paid total: <strong>RM @Model.Results.NonDemoPaidTotal.ToString("N2")</strong></p>
<p>Simulated Paid total: <strong>RM @Model.Results.DemoPaidTotal.ToString("N2")</strong> — Demo — no real payment processed.</p>
<p class="mb-0">Only matching Paid records contribute to totals. Unpaid/Voided records do not. This list contains recorded transactions; orders without a payment record are not listed.</p></div>
    @if (Model.Results.Count == 0) { <div class="tg-card p-4">No transactions match these filters.</div> }
    else
    {
        <div class="tg-card p-3 table-responsive"><table class="table align-middle"><caption>All matching transactions, newest first. Totals cover these results.</caption>
        <thead><tr><th>Payment / order</th><th>Customer / recorded by</th><th>Recorded (Malaysia)</th><th>Method</th><th>Status</th><th>Amount (RM)</th><th>Links</th></tr></thead><tbody>
        @foreach (var row in Model.Results.Rows)
        {
            <tr><td>#@row.Id / #@row.OrderId</td><td>@row.CustomerName<br />Recorded by: @row.StaffName</td><td>@MalaysiaTime.FromUtc(row.PaidAtUtc).ToString("dd MMM yyyy HH:mm")</td>
<td>@row.Method @if (row.Method == PaymentMethod.SimulatedOnline) { <span class="badge text-bg-warning">Demo — no real payment processed</span> }</td>
<td>@row.Status</td><td>@row.Amount.ToString("N2")</td><td>
@if (row.Status == PaymentStatus.Paid) { <a asp-area="Staff" asp-page="/Billing/Receipt" asp-route-id="@row.Id">Receipt</a><br /> }
<a asp-area="Staff" asp-page="/Billing/Details" asp-route-id="@row.OrderId">Order / bill details</a></td></tr>
        }
        </tbody></table></div>
    }
}
