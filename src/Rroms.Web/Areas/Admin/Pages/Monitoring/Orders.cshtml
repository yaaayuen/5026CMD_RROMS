@page
@model Rroms.Web.Areas.Admin.Pages.Monitoring.OrdersModel
@using Rroms.Web.Common
@using Rroms.Web.Contracts
@{ ViewData["Title"] = "Monitor orders"; }
<div class="hero mb-4"><h1>Monitor orders</h1><p>Filter by order placement date. Both dates are inclusive, in Malaysia time (UTC+8). Refresh to see updates.</p></div>
<partial name="_MonitoringNav" />
<div class="tg-card p-4 mb-4"><form method="get" class="row g-3 align-items-end">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="col-md-3"><label asp-for="Filter.From" class="form-label">From date</label><input asp-for="Filter.From" asp-format="{0:yyyy-MM-dd}" type="date" required class="form-control" /></div>
<div class="col-md-3"><label asp-for="Filter.To" class="form-label">To date</label><input asp-for="Filter.To" asp-format="{0:yyyy-MM-dd}" type="date" required class="form-control" /></div>
<div class="col-md-3"><label asp-for="Filter.Status" class="form-label">Status</label><select asp-for="Filter.Status" asp-items="Html.GetEnumSelectList<OrderStatus>()" class="form-select"><option value="">All statuses</option></select></div>

<div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary">Apply filters</button><a asp-page="Orders" class="btn btn-outline-secondary">Today / Reset</a></div>
</form></div>
@if (Model.Loaded)
{
    <p><strong>@Model.Results.Count order(s) · Saved order total: RM @Model.Results.OrderTotal.ToString("N2")</strong>. Includes every filtered order, including cancelled orders when selected. This is not paid sales.</p>
    @if (Model.Results.Count == 0) { <div class="tg-card p-4">No orders match these filters.</div> }
    else
    {
        <div class="tg-card p-3 table-responsive"><table class="table align-middle"><caption>All matching orders, newest first. Totals cover these results.</caption>
        <thead><tr><th>Order / booking</th><th>Customer</th><th>Placed (Malaysia)</th><th>Table</th><th>Status</th><th>Saved total (RM)</th><th>Details</th></tr></thead><tbody>
        @foreach (var row in Model.Results.Rows)
        {
            <tr><td>#@row.Id / #@row.ReservationId</td><td>@row.CustomerName</td><td>@MalaysiaTime.FromUtc(row.PlacedAtUtc).ToString("dd MMM yyyy HH:mm")</td>
<td>@row.TableLabel</td><td>@row.Status</td><td>@row.TotalAmount.ToString("N2")</td>
<td><a asp-area="Staff" asp-page="/Billing/Details" asp-route-id="@row.Id">Order / bill details</a></td></tr>
        }
        </tbody></table></div>
    }
}
