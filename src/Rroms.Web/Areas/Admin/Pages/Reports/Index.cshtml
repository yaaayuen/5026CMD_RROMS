@page
@model Rroms.Web.Areas.Admin.Pages.Reports.IndexModel
@using Rroms.Web.Models.ViewModels
@{ ViewData["Title"] = "Reports"; }
<link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
<div class="reports-page">
<header class="reports-heading">
    <div><a href="/Admin" class="reports-back">← Admin dashboard</a>
    <p class="reports-eyebrow">THREE GRILLS · BUSINESS INSIGHTS</p>
    <h1>Reports</h1><p class="reports-subtitle">A clearer view of your bookings, sales and guests.</p></div>
    <span class="reports-timezone">Malaysia time · MYT</span>
</header>
<div asp-validation-summary="All" class="text-danger reports-validation"></div>
<form method="get" id="report-filters" class="tg-card reports-filters">
    <div class="reports-filter-grid">
        <div class="reports-filter-field"><label asp-for="Filter.Period" class="form-label">Period</label><select asp-for="Filter.Period" asp-items="Html.GetEnumSelectList<ReportPeriod>()" class="form-select"></select></div>
        <div class="reports-filter-field" data-date-field="anchor"><label asp-for="Filter.Anchor" class="form-label">Reference date</label><input asp-for="Filter.Anchor" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
        <div class="reports-filter-field" data-date-field="custom"><label asp-for="Filter.From" class="form-label">From date</label><input asp-for="Filter.From" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
        <div class="reports-filter-field" data-date-field="custom"><label asp-for="Filter.To" class="form-label">To date</label><input asp-for="Filter.To" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
    </div>
    <p class="text-muted mt-2">Weeks run Monday–Sunday. Custom ranges include both dates, up to 366 days. Custom dates apply only when Custom is selected.</p>
    <div class="reports-filter-actions"><button class="btn btn-primary" type="submit">View report</button> <a href="/Admin/Reports" class="btn btn-outline-secondary">Reset</a></div>
</form>
@if (Model.Loaded)
{
    var r = Model.Results;
    <div class="reports-period"><p class="reports-eyebrow">YOUR REPORTING PERIOD</p><h2>@r.Range.From.ToString("dd MMM yyyy") – @r.Range.To.ToString("dd MMM yyyy")</h2></div>
    <div class="reports-metrics">
        <article class="report-metric"><span>Reservations</span><strong>@r.ReservationCount.ToString("N0")</strong><small>All booking statuses</small></article>
        <article class="report-metric"><span>Booked guests</span><strong>@r.GuestCount.ToString("N0")</strong><small>Booked places, not attendance</small></article>
        <article class="report-metric report-metric-primary"><span>Gross payments</span><strong>RM @r.NonDemoPaidTotal.ToString("N2")</strong><small>Gross recorded payments, before refunds</small></article>
        <article class="report-metric"><span>Net payments</span><strong>RM @r.NetTotal.ToString("N2")</strong><small>After completed refunds</small></article>
    </div>
    <div class="tg-card reports-workspace">
    <nav class="report-tabs" aria-label="Report sections">
        <a id="tab-reservations" href="#reservations">Reservations</a>
        <a id="tab-sales" href="#sales">Sales</a>
        <a id="tab-items" href="#items">Popular items</a>
        <a id="tab-customers" href="#customers">Customer activity</a>
    </nav>
    <form method="get" class="report-export-bar">
        <input type="hidden" name="handler" value="Export" />
        <input type="hidden" name="Filter.Period" value="Custom" />
        <input type="hidden" name="Filter.From" value="@r.Range.From.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="Filter.To" value="@r.Range.To.ToString("yyyy-MM-dd")" />
        <label for="export-kind" class="report-export-label">Report to download</label>
        <select id="export-kind" name="kind" asp-items="Html.GetEnumSelectList<ReportExportKind>()" class="form-select report-export-select"></select>
        <div class="report-export-buttons">
            <button name="format" value="Csv" class="btn btn-outline-primary btn-sm">Download CSV</button>
            <button name="format" value="Excel" class="btn btn-outline-primary btn-sm">Download Excel</button>
            <button name="format" value="Pdf" class="btn btn-outline-primary btn-sm">Download PDF</button>
        </div>
        <small class="report-export-note">Downloads use the displayed date range and current data. Apply changed filters with View report first.</small>
    </form>
    <section id="reservations" class="report-panel">
        <h2>Reservations</h2><details class="report-rules"><summary>How this report is calculated</summary><p>Based on reservation start date. All statuses are included; guest totals are booked guests, not attendance or occupancy.</p></details>
        <p><strong>@r.ReservationCount reservations · @r.GuestCount guests</strong></p>
        <div class="table-responsive"><table class="table report-table"><thead><tr><th>Status</th><th>Reservations</th><th>Guests</th></tr></thead><tbody>
        @foreach (var row in r.Reservations) { <tr><td><span class="report-status status-@row.Status.ToString().ToLowerInvariant()">@row.Status</span></td><td>@row.Count</td><td>@row.Guests</td></tr> }
        </tbody></table></div>
    </section>
    <section id="sales" class="report-panel">
        <p><a asp-area="Staff" asp-page="/Billing/Refunds" class="btn btn-outline-primary btn-sm">All refund requests and records</a></p>
        <h2>Sales</h2><details class="report-rules"><summary>How this report is calculated</summary><p>Gross recorded Paid payments, based on payment date. Unpaid and voided payments are excluded. Completed refunds below use refund completion date; pending/rejected requests are excluded. Net totals can be negative when refunds relate to earlier payments. Item and customer activity tables remain gross.</p></details>
        <p><strong>@r.PaidCount paid payments · Gross RM @r.PaidTotal.ToString("N2")</strong></p>
        <div class="table-responsive"><table class="table report-table"><thead><tr><th>Payment method</th><th>Count</th><th>Amount (RM)</th></tr></thead><tbody>
        @foreach (var row in r.SalesMethods) { <tr><td>@row.Method</td><td>@row.Count</td><td>@row.Amount.ToString("N2")</td></tr> }
        </tbody></table></div>
        <h3>Daily sales</h3>
        <div class="table-responsive"><table class="table report-table"><thead><tr><th>Date</th><th>Payments</th><th>Gross (RM)</th></tr></thead><tbody>
        @foreach (var row in r.DailySales) { <tr><td>@row.Date.ToString("dd MMM yyyy")</td><td>@row.Count</td><td>@row.PaidAmount.ToString("N2")</td></tr> }
        </tbody></table></div>
        <h3 class="h5 mt-4">Refunds and net payments</h3>
        <p>Completed refunds: <strong>RM @r.RefundTotal.ToString("N2")</strong>.</p>
        <p>Net payments: <strong>RM @r.NetTotal.ToString("N2")</strong>.</p>
        <div class="table-responsive"><table class="table"><thead><tr><th>Receipt</th><th>Customer</th><th>Refund completed (Malaysia)</th><th>Method</th><th>Refund (RM)</th><th>Reason</th></tr></thead><tbody>
        @foreach(var refund in r.Refunds) { <tr><td><a asp-area="Staff" asp-page="/Billing/Receipt" asp-route-id="@refund.PaymentId">R-@refund.PaymentId.ToString("D4")</a></td><td>@refund.CustomerName</td><td>@Rroms.Web.Common.MalaysiaTime.FromUtc(refund.ProcessedAtUtc!.Value).ToString("dd MMM yyyy, h:mm tt")</td><td>@refund.Method</td><td>@refund.Amount.ToString("N2")</td><td>@refund.DecisionReason</td></tr> }
        </tbody></table></div>
        @if(r.Refunds.Count == 0) { <p>No completed refunds in this period.</p> }
    </section>
    <section id="items" class="report-panel">
        <h2>Popular items</h2><details class="report-rules"><summary>How this report is calculated</summary><p>Ranked by quantity in orders paid during this period. Ties use item ID. Names are current; line values use saved unit prices and may differ from recorded payment totals.</p></details>
        @if (r.PopularItems.Count == 0) { <div class="report-empty"><strong>No paid items in this period.</strong><p>Try another date range to explore more activity.</p></div> }
        else {
        <div class="table-responsive"><table class="table report-table"><thead><tr><th>Rank</th><th>Item</th><th>Quantity</th><th>Line value (RM)</th></tr></thead><tbody>
        @foreach (var row in r.PopularItems) { <tr><td><span class="report-rank">@row.Rank</span></td><td>@row.Name <small>(#@row.MenuItemId)</small></td><td>@row.Quantity</td><td>@row.LineValue.ToString("N2")</td></tr> }
        </tbody></table></div>
        }
    </section>
    <section id="customers" class="report-panel">
        <h2>Customer activity</h2><details class="report-rules"><summary>How this report is calculated</summary><p>Reservation counts use start date; order counts use placement date (all statuses); paid amounts use payment date. These are independent activities, not one booking cohort. Includes historical activity of inactive accounts. Names are current.</p></details>
        @if (r.Customers.Count == 0) { <div class="report-empty"><strong>No customer activity in this period.</strong><p>Try another date range to explore more activity.</p></div> }
        else {
        <div class="table-responsive"><table class="table report-table"><thead><tr><th>Customer</th><th>Reservations</th><th>Orders</th><th>Payments</th><th>Gross (RM)</th></tr></thead><tbody>
        @foreach (var row in r.Customers) { <tr><td>@row.CustomerName <small class="d-block report-customer-id">@row.CustomerId</small></td><td>@row.ReservationCount</td><td>@row.OrderCount</td><td>@row.PaidCount</td><td>@row.PaidAmount.ToString("N2")</td></tr> }
        </tbody></table></div>
        }
    </section>
    </div>
}
</div>
@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
