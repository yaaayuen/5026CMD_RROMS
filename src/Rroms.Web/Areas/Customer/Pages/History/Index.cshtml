@page
@model Rroms.Web.Areas.Customer.Pages.History.IndexModel
@using Rroms.Web.Areas.Customer.Pages.Orders
@using Rroms.Web.Common
@using Rroms.Web.Contracts
@using Rroms.Web.Models.ViewModels
@{
	ViewData["Title"] = "My history";

	CustomerHistory history = Model.History;
	decimal totalPaid = history.Payments.Where(p => p.Method != PaymentMethod.SimulatedOnline).Sum(p => p.Amount);
	HistoryPaymentRow? latestPayment = history.Payments.Where(p => p.Method != PaymentMethod.SimulatedOnline).OrderByDescending(p => p.PaidAtUtc).FirstOrDefault();
	bool paymentsCapped = history.Payments.Count >= Model.RowLimit;
}

@functions {
	private static string DateText(DateTime utc)
	{
		return MalaysiaTime.FromUtc(utc).ToString("d MMM yyyy");
	}

	private static string ClockText(DateTime utc)
	{
		return MalaysiaTime.FromUtc(utc).ToString("h:mm tt");
	}

	/// <summary>The soft badge colour for a reservation status (ok, warn, bad or muted).</summary>
	private static string ReservationTone(ReservationStatus status)
	{
		switch (status.ToString())
		{
			case "Confirmed":
			case "Seated":
			case "Completed":
				return "ok";
			case "Pending":
				return "warn";
			case "Cancelled":
			case "NoShow":
				return "bad";
			default:
				return "muted";
		}
	}

	/// <summary>A small icon for how a payment was made (decorative only).</summary>
	private static string MethodIcon(PaymentMethod method)
	{
		switch (method)
		{
			case PaymentMethod.Cash:
				return "💵";
			case PaymentMethod.CardTerminal:
				return "💳";
			case PaymentMethod.EWallet:
				return "📱";
			case PaymentMethod.SimulatedOnline:
				return "🌐";
			default:
				return "💳";
		}
	}
}

<style>
	/* My history polish (YJ-5). Only classes starting with hx- are defined here, so nothing else on the site changes. */
	.hx {
		--hx-card: #ffffff;
		--hx-ink: #23223a;
		--hx-muted: #6b6b7b;
		--hx-line: #f1e6e0;
		--hx-head: #fdf5f0;
		--hx-hover: #fffaf7;
		--hx-crimson: #d6104f;
		--hx-orange: #ff8a3d;
		--hx-green: #0f8a6d;
		--hx-green-bg: #e0f5ee;
		--hx-amber: #b45309;
		--hx-amber-bg: #fff0dc;
		--hx-red: #b42318;
		--hx-red-bg: #fde7e7;
		--hx-pink-bg: #ffe3ec;
		--hx-btn-border: #f6c6d4;
		--hx-shadow: 0 6px 24px rgba(214, 16, 79, 0.07);
	}
	:root[data-bs-theme="dark"] .hx,
	:root[data-theme="dark"] .hx,
	body[data-bs-theme="dark"] .hx,
	body.dark-theme .hx {
		--hx-card: #1f1e2b;
		--hx-ink: #f2f0f5;
		--hx-muted: #b3b0c0;
		--hx-line: #34324a;
		--hx-head: #28263a;
		--hx-hover: #262537;
		--hx-green: #5fd4b0;
		--hx-green-bg: #12382f;
		--hx-amber: #fbbf77;
		--hx-amber-bg: #3d2c14;
		--hx-red: #ff9b92;
		--hx-red-bg: #40201f;
		--hx-pink-bg: #3d1f2b;
		--hx-btn-border: #6a2a42;
		--hx-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
	}

	.hx-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 20px; }
	.hx-stat { position: relative; overflow: hidden; display: flex; align-items: center; gap: 14px; background: var(--hx-card); color: var(--hx-ink); border-radius: 18px; padding: 18px 20px; box-shadow: var(--hx-shadow); }
	.hx-stat::before { content: ""; position: absolute; left: 0; top: 14px; bottom: 14px; width: 4px; border-radius: 0 4px 4px 0; background: var(--hx-crimson); }
	.hx-stat.orders::before { background: var(--hx-orange); }
	.hx-stat.paid::before { background: var(--hx-green); }
	.hx-ico { flex: none; width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; font-size: 20px; background: var(--hx-pink-bg); }
	.hx-stat.orders .hx-ico { background: var(--hx-amber-bg); }
	.hx-stat.paid .hx-ico { background: var(--hx-green-bg); }
	.hx-num { font-family: inherit; font-variant-numeric: lining-nums tabular-nums; font-size: 28px; font-weight: 800; line-height: 1; }
	.hx-stat.paid .hx-num { color: var(--hx-green); }
	.hx-lab { font-size: 13px; color: var(--hx-muted); margin-top: 4px; }

	.hx-latest { display: flex; align-items: center; gap: 10px; background: var(--hx-card); color: var(--hx-muted); border-radius: 14px; padding: 12px 18px; margin-bottom: 20px; font-size: 14px; box-shadow: var(--hx-shadow); }
	.hx-latest b { color: var(--hx-ink); }
	.hx-dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--hx-green); box-shadow: 0 0 0 4px var(--hx-green-bg); }

	.hx-card { border-top: 4px solid var(--hx-crimson); color: var(--hx-ink); }
	.hx-card.orders { border-top-color: var(--hx-orange); }
	.hx-card.payments { border-top-color: var(--hx-green); }
	.hx-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
	.hx-title h2 { display: flex; align-items: center; gap: 10px; margin: 0; }
	.hx-title small { color: var(--hx-muted); font-weight: 600; }

	.hx-table { width: 100%; table-layout: fixed; border-collapse: collapse; }
	.hx-table th { background: var(--hx-head); color: var(--hx-muted); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; padding: 10px; text-align: left; border: 0; }
	.hx-table th:first-child { border-radius: 12px 0 0 12px; }
	.hx-table th:last-child { border-radius: 0 12px 12px 0; }
	.hx-table td { padding: 14px 10px; border-bottom: 1px solid var(--hx-line); vertical-align: middle; text-align: left; color: var(--hx-ink); }
	.hx-table tbody tr:last-child td { border-bottom: 0; }
	.hx-table tbody tr:hover td { background: var(--hx-hover); }
	.hx-two b { display: block; }
	.hx-two span, .hx-sub { display: block; font-size: 12.5px; color: var(--hx-muted); margin-top: 2px; }
	.hx-amt { font-weight: 400; font-size: 15px; }

	.hx-tile { display: flex; align-items: center; gap: 12px; }
	.hx-cal { flex: none; width: 48px; height: 52px; border-radius: 13px; background: linear-gradient(160deg, #e0245e, #ff6b4a); color: #fff; display: grid; place-items: center; text-align: center; font-size: 10px; font-weight: 800; letter-spacing: .08em; line-height: 1; padding-top: 6px; box-shadow: 0 6px 14px -6px rgba(214, 16, 79, .6); }
	   .hx-cal b { font-family: inherit; font-variant-numeric: lining-nums; font-size: 20px; font-weight: 800; letter-spacing: 0; margin-top: 2px; }

	.hx-chip { display: inline-block; min-width: 46px; text-align: center; padding: 6px 12px; border-radius: 12px; font-weight: 800; font-size: 14px; }
	.hx-chip.order { background: var(--hx-amber-bg); color: var(--hx-amber); }
	.hx-chip.receipt { background: var(--hx-green-bg); color: var(--hx-green); }

	.hx-badge { display: inline-block; padding: 5px 12px; border-radius: 99px; font-size: 12px; font-weight: 800; background: var(--hx-green-bg); color: var(--hx-green); }
	.hx-badge::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: currentColor; margin-right: 7px; vertical-align: middle; }
	.hx-badge.warn { background: var(--hx-amber-bg); color: var(--hx-amber); }
	.hx-badge.bad { background: var(--hx-red-bg); color: var(--hx-red); }
	.hx-badge.muted { background: var(--hx-head); color: var(--hx-muted); }

	.hx-mi { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 10px; background: var(--hx-head); margin-right: 10px; font-size: 15px; vertical-align: middle; }

	.hx-btn { display: inline-block; padding: 8px 16px; border-radius: 99px; border: 1.5px solid var(--hx-btn-border); background: transparent; color: var(--hx-crimson); font-size: 13.5px; font-weight: 700; text-decoration: none; }
	.hx-btn:hover, .hx-btn:focus-visible { background: var(--hx-crimson); border-color: var(--hx-crimson); color: #fff; }

	@@media (max-width: 640px) {
		.hx-stats { gap: 8px; }
		.hx-stat { flex-direction: column; align-items: flex-start; gap: 8px; padding: 12px; }
		.hx-ico { width: 34px; height: 34px; font-size: 16px; }
		.hx-num { font-size: 20px; }
		.hx-lab { font-size: 11px; }
		.hx-table colgroup, .hx-table thead { display: none; }
		.hx-table, .hx-table tbody, .hx-table tr, .hx-table td { display: block; width: 100%; }
		.hx-table tr { border: 1px solid var(--hx-line); border-radius: 14px; padding: 10px 12px; margin-bottom: 10px; }
		.hx-table td { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; border: 0; padding: 4px 0; text-align: right; }
		.hx-table td::before { content: attr(data-label); color: var(--hx-muted); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; padding-top: 2px; text-align: left; }
		.hx-table td.hx-action { justify-content: flex-end; }
		.hx-table td.hx-action::before { content: none; }
		.hx-mi { display: none; }
		.hx-tile { flex-direction: row-reverse; }
	}
</style>

<div class="hx">
	<section class="hero hero-compact mb-4" aria-labelledby="history-heading">
		<span class="hero-bubble one" aria-hidden="true"></span>
		<div class="position-relative">
			<span class="eyebrow">My dining</span>
			<h1 id="history-heading" class="mb-1">My history</h1>
			<p class="lead mb-0">Your reservations, orders and payments in one place, newest first.</p>
		</div>
	</section>

	<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <p class="small text-secondary mb-0">Payment totals are before refunds. Open a receipt for its refund status and final net amount.</p>
        <a class="hx-btn" asp-area="Customer" asp-page="/Refunds/Index">My refund records</a>
    </div>
    <div class="hx-stats" aria-label="Summary">
		<div class="hx-stat">
			<span class="hx-ico" aria-hidden="true">📅</span>
			<div>
				<div class="hx-num">@history.Reservations.Count</div>
				<div class="hx-lab">Reservations</div>
			</div>
		</div>
		<div class="hx-stat orders">
			<span class="hx-ico" aria-hidden="true">🍽️</span>
			<div>
				<div class="hx-num">@history.Orders.Count</div>
				<div class="hx-lab">Orders</div>
			</div>
		</div>
		<div class="hx-stat paid">
			<span class="hx-ico" aria-hidden="true">💳</span>
			<div>
				<div class="hx-num">RM @totalPaid.ToString("N2")</div>
				<div class="hx-lab">@(paymentsCapped ? "Gross paid (latest " + Model.RowLimit + ")" : "Gross paid")</div>
			</div>
		</div>
	</div>

	@if (latestPayment != null)
	{
		<div class="hx-latest" role="status">
			<span class="hx-dot" aria-hidden="true"></span>
			<span><b>Latest activity</b> · Paid RM @latestPayment.Amount.ToString("N2") by @IndexModel.MethodText(latestPayment.Method).ToLowerInvariant() for Order #@latestPayment.OrderId · @IndexModel.FormatTime(latestPayment.PaidAtUtc)</span>
		</div>
	}

	<section class="tg-card h-auto mb-4 hx-card" aria-labelledby="reservations-heading">
		<div class="hx-title">
			<h2 id="reservations-heading" class="h4"><span class="hx-ico" aria-hidden="true">📅</span>My reservations</h2>
		</div>

		@if (history.Reservations.Count == 0)
		{
			<p class="text-secondary mb-0" role="status">No reservations yet.</p>
		}
		else
		{
			<table class="hx-table">
				<colgroup>
					<col style="width:18%"><col style="width:22%"><col style="width:16%"><col style="width:26%"><col style="width:18%">
				</colgroup>
				<thead>
					<tr>
						<th scope="col">Date</th>
						<th scope="col">Table</th>
						<th scope="col">Guests</th>
						<th scope="col">Status</th>
						<th scope="col"><span class="visually-hidden">Details</span></th>
					</tr>
				</thead>
				<tbody>
					@foreach (HistoryReservationRow row in history.Reservations)
					{
						DateTime start = MalaysiaTime.FromUtc(row.StartUtc);
						<tr>
							<td data-label="Date">
								<div class="hx-tile">
									<span class="hx-cal" aria-hidden="true">@start.ToString("MMM").ToUpperInvariant()<b>@start.Day</b></span>
									<span class="hx-two"><b>@start.ToString("ddd d MMM yyyy")</b><span>@ClockText(row.StartUtc)</span></span>
								</div>
							</td>
							<td data-label="Table">@row.TableLabel · @row.AreaName</td>
							<td data-label="Guests">@row.PartySize</td>
							<td data-label="Status"><span class="hx-badge @ReservationTone(row.Status)">@row.Status</span></td>
							<td class="hx-action"><a class="hx-btn" asp-page="/Reservations/Details" asp-route-id="@row.Id">View booking <span aria-hidden="true">→</span></a></td>
						</tr>
					}
				</tbody>
			</table>

			@if (history.Reservations.Count >= Model.RowLimit)
			{
				<p class="small text-secondary mt-2 mb-0">Showing your latest @Model.RowLimit reservations.</p>
			}
		}
	</section>

	<section class="tg-card h-auto mb-4 hx-card orders" aria-labelledby="orders-heading">
		<div class="hx-title">
			<h2 id="orders-heading" class="h4"><span class="hx-ico" aria-hidden="true">🍽️</span>My orders</h2>
		</div>

		@if (history.Orders.Count == 0)
		{
			<p class="text-secondary mb-0" role="status">No orders yet.</p>
		}
		else
		{
			<table class="hx-table">
				<colgroup>
					<col style="width:18%"><col style="width:22%"><col style="width:16%"><col style="width:26%"><col style="width:18%">
				</colgroup>
				<thead>
					<tr>
						<th scope="col">Order</th>
						<th scope="col">Placed</th>
						<th scope="col">Total (RM)</th>
						<th scope="col">Payment</th>
						<th scope="col"><span class="visually-hidden">Details</span></th>
					</tr>
				</thead>
				<tbody>
					@foreach (HistoryOrderRow row in history.Orders)
					{
						HistoryPaymentRow? paid = history.Payments.FirstOrDefault(p => p.OrderId == row.Id);
						bool cancelled = row.Status.ToString() == "Cancelled";
						<tr>
							<td data-label="Order">
								<span class="hx-chip order">#@row.Id</span>
								<span class="hx-sub">@DetailsModel.StatusText(row.Status)</span>
							</td>
							<td data-label="Placed" class="hx-two"><b>@DateText(row.PlacedAtUtc)</b><span>@ClockText(row.PlacedAtUtc)</span></td>
							<td data-label="Total" class="hx-amt">@row.TotalAmount.ToString("N2")</td>
							<td data-label="Payment">
								@if (paid != null)
								{
									<span class="hx-badge">Payment recorded</span>
                                    <a class="hx-btn mt-2" asp-area="Customer" asp-page="/Receipts/Details" asp-route-id="@paid.ReceiptNumber">View receipt</a>
									<span class="hx-sub">@(paid.Method == PaymentMethod.SimulatedOnline ? "Archived test payment" : IndexModel.MethodText(paid.Method)) · Receipt #@paid.ReceiptNumber</span>
								}
								else if (cancelled)
								{
									<span class="hx-sub">No payment</span>
								}
								else
								{
									<span class="hx-badge warn">@(paymentsCapped ? "Check order" : "Unpaid")</span>
								}
							</td>
							<td class="hx-action"><a class="hx-btn" asp-page="/Orders/Details" asp-route-id="@row.Id">View order <span aria-hidden="true">→</span></a></td>
						</tr>
					}
				</tbody>
			</table>

			@if (history.Orders.Count >= Model.RowLimit)
			{
				<p class="small text-secondary mt-2 mb-0">Showing your latest @Model.RowLimit orders.</p>
			}
		}
	</section>

	<section class="tg-card h-auto mb-4 hx-card payments" aria-labelledby="payments-heading">
		<div class="hx-title">
			<h2 id="payments-heading" class="h4"><span class="hx-ico" aria-hidden="true">💳</span>My payments</h2>
			@if (paymentsCapped)
			{
				<small>Latest @Model.RowLimit shown</small>
			}
		</div>

		@if (history.Payments.Count == 0)
		{
			<p class="text-secondary mb-0" role="status">No payments yet.</p>
		}
		else
		{
			<table class="hx-table">
				<colgroup>
					<col style="width:18%"><col style="width:22%"><col style="width:16%"><col style="width:26%"><col style="width:18%">
				</colgroup>
				<thead>
					<tr>
						<th scope="col">Receipt</th>
						<th scope="col">Paid</th>
						<th scope="col">Amount (RM)</th>
						<th scope="col">Method</th>
						<th scope="col">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (HistoryPaymentRow row in history.Payments)
					{
						<tr>
							<td data-label="Receipt"><a class="hx-chip receipt text-decoration-none" asp-area="Customer" asp-page="/Receipts/Details" asp-route-id="@row.ReceiptNumber">R-@row.ReceiptNumber.ToString("D4")</a></td>
							<td data-label="Paid" class="hx-two"><b>@DateText(row.PaidAtUtc)</b><span>@ClockText(row.PaidAtUtc)</span></td>
							<td data-label="Amount" class="hx-amt">@row.Amount.ToString("N2")</td>
							<td data-label="Method"><span class="hx-mi" aria-hidden="true">@MethodIcon(row.Method)</span>@(row.Method == PaymentMethod.SimulatedOnline ? "Archived test payment" : IndexModel.MethodText(row.Method))</td>
							<td class="hx-action"><div class="d-flex flex-wrap gap-2">
                                <a class="hx-btn" asp-area="Customer" asp-page="/Receipts/Details" asp-route-id="@row.ReceiptNumber">View receipt</a>
                                <a class="hx-btn" asp-page="/Orders/Details" asp-route-id="@row.OrderId">Order #@row.OrderId <span aria-hidden="true">→</span></a>
                            </div></td>
						</tr>
					}
				</tbody>
			</table>

			@if (paymentsCapped)
			{
				<p class="small text-secondary mt-2 mb-0">Showing your latest @Model.RowLimit payments.</p>
			}
		}
	</section>
</div>
