@model Rroms.Web.Areas.Customer.Pages.Tracking.IndexModel
@using Rroms.Web.Common
@using Rroms.Web.Contracts
@using Rroms.Web.Models
@using Rroms.Web.Services
@{
    // Bookings that can still change are shown first; finished ones are folded away.
    var current = Model.Reservations
        .Where(r => r.Status is ReservationStatus.Pending or ReservationStatus.Confirmed or ReservationStatus.Seated)
        .OrderBy(r => r.StartUtc).ToList();
    var past = Model.Reservations.Except(current).OrderByDescending(r => r.StartUtc).ToList();
    // Each order is shown under the visit it belongs to, so customers never need a reservation number.
    var ordersByVisit = Model.Orders.ToLookup(o => o.ReservationId);
    DateTime today = MalaysiaTime.FromUtc(DateTime.UtcNow).Date;

    // One order: the stepper (or a Cancelled badge), the dishes and the total. Past visits show a badge instead of the stepper.
    void RenderOrder(Order order, ReservationStatus visitStatus, bool stepper)
    {
        int now = Array.IndexOf(OrderStatusRules.Steps, order.Status);
        <article class="track-order">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h3 class="h6 mb-0">Order #@order.Id</h3>
                @if (order.Status == OrderStatus.Cancelled)
                {
                    <span class="badge text-bg-danger">Cancelled</span>
                }
                else if (!stepper)
                {
                    <span class="badge text-bg-secondary">@OrderStatusRules.Label(order.Status)</span>
                }
                <span class="ms-auto fw-semibold">RM @order.TotalAmount.ToString("0.00")</span>
            </div>
            @if (stepper && now >= 0)
            {
                <ol class="order-steps" aria-label="Order progress">
                    @for (int i = 0; i < OrderStatusRules.Steps.Length; i++)
                    {
                        bool done = i < now || (i == now && i == OrderStatusRules.Steps.Length - 1);
                        <li class="@(i < now ? "is-done" : i == now ? "is-current" : null)" aria-current="@(i == now ? "step" : null)">
                            <span class="order-step-mark" aria-hidden="true">@(done ? "✓" : (i + 1).ToString())</span>
                            @if (i < now) { <span class="visually-hidden">Done:</span> }
                            @OrderStatusRules.Label(OrderStatusRules.Steps[i])
                        </li>
                    }
                </ol>
            }
            @if (order.Status == OrderStatus.Placed && visitStatus != ReservationStatus.Seated)
            {
                <p class="small text-secondary mb-2">Your pre-order is saved. The kitchen receives it after you are seated.</p>
            }
            <ul class="track-dishes list-unstyled mb-0">
                @foreach (var item in order.Items)
                {
                    <li><span class="text-secondary">@item.Quantity ×</span> @item.MenuItem?.Name</li>
                }
            </ul>
        </article>
    }
}
<section class="tg-card h-auto mb-4" aria-labelledby="track-reservations-heading">
    <h2 id="track-reservations-heading" class="h4 mb-3">Your visits</h2>
    @if (Model.Reservations.Count == 0)
    {
        <p class="mb-0 text-secondary">You have no reservations yet. <a asp-area="Customer" asp-page="/Reservations/Book">Book a table</a></p>
    }
    else if (current.Count == 0)
    {
        <p class="text-secondary">No upcoming visits. <a asp-area="Customer" asp-page="/Reservations/Book">Book a table</a></p>
    }
    <ul class="track-list list-unstyled mb-0">
        @foreach (var booking in current)
        {
            DateTime start = MalaysiaTime.FromUtc(booking.StartUtc);
            DateTime end = MalaysiaTime.FromUtc(booking.EndUtc);
            // Today's and ongoing visits show everything here; future ones keep the View button.
            bool happeningNow = booking.Status == ReservationStatus.Seated
                || (booking.Status == ReservationStatus.Confirmed && start.Date == today);
            <li class="track-visit">
                <div class="track-date" aria-hidden="true"><span>@start.ToString("MMM")</span><strong>@start.Day</strong></div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">@start.ToString("dddd d MMMM") · @start.ToString("h:mm tt") – @end.ToString("h:mm tt")</div>
                    <div class="small text-secondary">@booking.PartySize @(booking.PartySize == 1 ? "guest" : "guests") · Table @booking.TableLabel · @booking.AreaName</div>
                    @if (happeningNow && !string.IsNullOrWhiteSpace(booking.SpecialRequests))
                    {
                        <div class="small text-secondary">Your note: @booking.SpecialRequests</div>
                    }
                </div>
                <span class="badge @ReservationStatusDisplay.BadgeClass(booking.Status)">@booking.Status</span>
                @if (happeningNow)
                {
                    <a class="small" asp-area="Customer" asp-page="/Reservations/Details" asp-route-id="@booking.Id"
                       aria-label="Manage booking on @start.ToString("d MMMM")">Manage booking</a>
                }
                else
                {
                    <a class="btn btn-outline-primary btn-sm" asp-area="Customer" asp-page="/Reservations/Details" asp-route-id="@booking.Id"
                       aria-label="View reservation on @start.ToString("d MMMM")">View</a>
                }
                @if (ordersByVisit[booking.Id].Any())
                {
                    <div class="track-orders">
                        @foreach (var order in ordersByVisit[booking.Id]) { RenderOrder(order, booking.Status, true); }
                    </div>
                }
            </li>
        }
    </ul>
    @if (past.Count > 0)
    {
        <details class="track-past mt-3" id="track-past">
            <summary>Past visits (@past.Count)</summary>
            <ul class="list-unstyled mb-0 mt-2">
                @foreach (var booking in past)
                {
                    DateTime start = MalaysiaTime.FromUtc(booking.StartUtc);
                    <li class="track-past-visit">
                        <div class="d-flex align-items-center gap-2">
                            <a asp-area="Customer" asp-page="/Reservations/Details" asp-route-id="@booking.Id">@start.ToString("ddd d MMM yyyy, h:mm tt")</a>
                            <span class="badge @ReservationStatusDisplay.BadgeClass(booking.Status) ms-auto">@booking.Status</span>
                        </div>
                        @if (ordersByVisit[booking.Id].Any())
                        {
                            <div class="track-orders">
                                @foreach (var order in ordersByVisit[booking.Id]) { RenderOrder(order, booking.Status, false); }
                            </div>
                        }
                        else
                        {
                            <p class="small text-secondary mb-0">No food was ordered for this visit.</p>
                        }
                    </li>
                }
            </ul>
        </details>
    }
</section>
