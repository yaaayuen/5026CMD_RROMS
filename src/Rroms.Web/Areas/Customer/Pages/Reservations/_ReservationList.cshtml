@*
    Table of reservations, used twice on My reservations (upcoming and past).
    Times are stored in UTC and shown in Malaysia time.
*@
@using Rroms.Web.Common
@model ReservationReceiptList

<div class="table-responsive">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Time</th>
                <th scope="col">Guests</th>
                <th scope="col">Table</th>
                <th scope="col">Status</th>
                <th scope="col">Receipt</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ReservationSummary reservation in Model.Reservations)
            {
                DateTime start = MalaysiaTime.FromUtc(reservation.StartUtc);
                DateTime end = MalaysiaTime.FromUtc(reservation.EndUtc);
                <tr>
                    <td>
                        <a asp-page="Details" asp-route-id="@reservation.Id">@start.ToString("ddd d MMM yyyy")</a>
                        @if (!string.IsNullOrEmpty(reservation.SpecialRequests))
                        {
                            <div class="small text-secondary">@reservation.SpecialRequests</div>
                        }
                    </td>
                    <td>@start.ToString("h:mm tt") – @end.ToString("h:mm tt")</td>
                    <td>@reservation.PartySize</td>
                    <td>@reservation.TableLabel <span class="text-secondary">· @reservation.AreaName</span></td>
                    <td><span class="badge @IndexModel.StatusBadgeClass(reservation.Status)">@Rroms.Web.Common.ReservationStatusDisplay.Label(reservation.Status)</span></td>
                    <td>
                    @foreach (var receipt in Model.Receipts[reservation.Id]) {
                        <a asp-area="Customer" asp-page="/Receipts/Details" asp-route-id="@receipt.PaymentId" class="btn btn-outline-primary btn-sm mb-1">View receipt <span class="visually-hidden">R-@receipt.PaymentId.ToString("D4")</span></a>
                    }
                    @if (!Model.Receipts[reservation.Id].Any()) { <span class="text-secondary">Not paid</span> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>