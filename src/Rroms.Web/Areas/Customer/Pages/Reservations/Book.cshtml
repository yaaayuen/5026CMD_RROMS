@page
@model BookModel
@{
	ViewData["Title"] = "Book a table";
}

<section class="hero hero-compact mb-4" aria-labelledby="book-heading">
	<span class="hero-bubble one" aria-hidden="true"></span>
	<div class="position-relative">
		<span class="eyebrow">Reservations</span>
		<h1 id="book-heading" class="mb-1">Book a table</h1>
		<p class="lead mb-0">Choose a day, a time and how many guests. We only show tables that are free.</p>
	</div>
</section>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<section class="tg-card h-auto mb-4" aria-labelledby="search-heading">
	<h2 id="search-heading" class="h4 mb-3">1. When and how many?</h2>

	@* GET form: searching only reads data. Changing the date reloads the page so the times match that day. *@
	<form method="get">
		<div class="row g-3 align-items-end">
			<div class="col-md-4">
				<label asp-for="Search.Date" class="form-label fw-semibold"></label>
				<input asp-for="Search.Date" type="date" class="form-control"
					   min="@Model.MinDate.ToString("yyyy-MM-dd")" max="@Model.MaxDate.ToString("yyyy-MM-dd")"
					   onchange="this.form.submit()" />
			</div>

			<div class="col-md-3">
				<label for="search-time" class="form-label fw-semibold">Time</label>
				@if (Model.StartTimes.Count == 0)
				{
					<p id="search-time" class="form-control-plaintext text-danger mb-0">Closed on this day</p>
				}
				else
				{
					<select id="search-time" name="Search.Time" class="form-select">
						@foreach (TimeOnly time in Model.StartTimes)
						{
							<option value="@time.ToString("HH:mm")" selected="@(time == Model.Search.Time)">@time.ToString("h:mm tt")</option>
						}
					</select>
				}
			</div>

			<div class="col-md-2">
				<label asp-for="Search.PartySize" class="form-label fw-semibold"></label>
				<input asp-for="Search.PartySize" class="form-control" min="@Model.MinPartySize" max="@Model.MaxPartySize" />
			</div>

			<div class="col-md-3">
				<button type="submit" name="Find" value="true" class="btn btn-primary w-100"
						disabled="@(Model.StartTimes.Count == 0)">
					Find tables
				</button>
			</div>
		</div>
	</form>
</section>

@if (Model.Results != null)
{
	<section class="tg-card h-auto" aria-labelledby="results-heading">
		<h2 id="results-heading" class="h4 mb-3">2. Choose your table</h2>

		@if (Model.Results.Count == 0)
		{
			string day = Model.Search.Date.ToString("dddd d MMMM");
			string nextDay = Model.Search.Date.AddDays(1).ToString("yyyy-MM-dd");
			if (Model.Search.PartySize > Model.LargestTableSeats)
			{
				@* No single table is big enough: say so instead of suggesting times that can never work. *@
				<p class="mb-0">Our largest table seats @Model.LargestTableSeats guests. For a group of @Model.Search.PartySize,
					please contact the restaurant so we can arrange a larger setting for you.</p>
			}
			else if (Model.OtherFreeTimes.Count > 0)
			{
				<p>Sorry, every table for @Model.Search.PartySize is taken at @Model.Search.Time.ToString("h:mm tt").
					These times on @day still have a free table:</p>
				<div class="d-flex flex-wrap gap-2">
					@foreach (TimeOnly time in Model.OtherFreeTimes)
					{
						<a class="btn btn-sm btn-outline-primary"
						   href="?Search.Date=@Model.Search.Date.ToString("yyyy-MM-dd")&Search.Time=@time.ToString("HH:mm")&Search.PartySize=@Model.Search.PartySize&Find=true">@time.ToString("h:mm tt")</a>
					}
				</div>
			}
			else
			{
				<p class="mb-2">Sorry, we are fully booked for @Model.Search.PartySize on @day. Please choose another day.</p>
				<a class="btn btn-sm btn-outline-primary"
				   href="?Search.Date=@nextDay&Search.PartySize=@Model.Search.PartySize">Try the next day</a>
			}
		}
		else
		{
			<form method="post">
				@* The search values travel with the booking, so the server can check them again. *@
				<input type="hidden" name="Search.Date" value="@Model.Search.Date.ToString("yyyy-MM-dd")" />
				<input type="hidden" name="Search.Time" value="@Model.Search.Time.ToString("HH:mm")" />
				<input type="hidden" name="Search.PartySize" value="@Model.Search.PartySize" />

				@* Floor plan (Alex, Part 20): click a gold table to pick it. It sets the same radio buttons as the list below. *@
				@if (Model.FloorPlanJson != null)
				{
					<div class="fp-pick mb-3" data-floor-plan="pick" data-source="floorPlanData" data-input="DiningTableId">
						<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
							<div class="fp-area-tabs" data-areas role="group" aria-label="Dining areas"></div>
							<p class="fp-summary mb-0 ms-auto" data-summary aria-live="polite"></p>
						</div>
						<div class="fp-mapbox"><svg class="fp-map" id="bookMap" role="radiogroup" aria-label="Floor plan: choose a table"></svg></div>
						<ul class="fp-legend list-unstyled small mb-0 mt-2">
							<li><span class="fp-key is-free" aria-hidden="true"></span>Free for your group</li>
							<li><span class="fp-key is-best" aria-hidden="true">★</span>Best fit</li>
							<li><span class="fp-key is-small" aria-hidden="true"></span>Too small for your group</li>
							<li><span class="fp-key is-taken" aria-hidden="true"></span>Already booked</li>
						</ul>
					</div>
					<script type="application/json" id="floorPlanData">@Html.Raw(Model.FloorPlanJson)</script>
					<p class="small text-secondary mb-2">Or choose from the list:</p>
				}

				<div class="list-group mb-3">
					@for (int i = 0; i < Model.Results.Count; i++)
					{
						AvailableTable table = Model.Results[i];
						<label class="list-group-item d-flex align-items-center gap-3">
							<input class="form-check-input mt-0" type="radio" name="DiningTableId"
								   value="@table.DiningTableId" checked="@(i == 0)" />
							<span>
								<strong>Table @table.Label</strong>
								<span class="text-secondary">· @table.AreaName · @table.Capacity seats</span>
							</span>
						</label>
					}
				</div>

				<div class="mb-3">
					<label asp-for="SpecialRequests" class="form-label fw-semibold">Special requests (optional)</label>
					<textarea asp-for="SpecialRequests" class="form-control" rows="2"
							  maxlength="@Rroms.Web.Models.Reservation.SpecialRequestsMaxLength"
							  placeholder="e.g. Birthday cake, high chair, wheelchair access, anniversary"></textarea>
					@* Special requests go to the front desk only; food allergies belong in the kitchen note on the order page. *@
					<div class="form-text">For food allergies, add a note for the kitchen when you order.</div>
				</div>

				<button type="submit" class="btn btn-primary">
					Book for @Model.Search.PartySize on @Model.Search.Date.ToString("ddd d MMM") at @Model.Search.Time.ToString("h:mm tt")
				</button>
			</form>
		}
	</section>
}

<p class="mt-4"><a asp-page="Index">See my reservations</a></p>

@section Scripts {
	@if (Model.FloorPlanJson != null)
	{
		<script src="~/js/floor-plan.js" asp-append-version="true"></script>
	}
}
