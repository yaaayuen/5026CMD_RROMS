@page "{id:int}"
@model DetailsModel
@using Rroms.Web.Common
@using Rroms.Web.Contracts
@{
	ViewData["Title"] = "My order";
	DateTime placed = MalaysiaTime.FromUtc(Model.Summary.PlacedAtUtc);
}

<style>
	/* Order details page (YJ-3). Only site colours and fonts, so light and dark mode follow the theme. */
	.od-status { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; }
	.od-status .od-hint { color: var(--tg-muted); font-size: .875rem; margin: .35rem 0 0; }
	.od-list { list-style: none; margin: 0; padding: 0; }
	.od-line { display: flex; align-items: center; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid color-mix(in srgb, var(--tg-muted) 25%, transparent); }
	.od-line:last-child { border-bottom: 0; }
	.od-thumb { width: 4rem; height: 4rem; flex: none; border-radius: var(--bs-border-radius); overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--tg-gradient); color: #fff; font-family: var(--tg-font-heading); font-weight: 700; font-size: 1.4rem; }
	.od-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.od-name { flex: 1; min-width: 0; }
	.od-name strong { display: block; }
	.od-meta { color: var(--tg-muted); font-size: .85rem; }
	.od-note { display: inline-block; margin-top: .3rem; padding: .1rem .6rem; border-radius: 99px; background: var(--tg-blush); color: var(--tg-ink); font-size: .8rem; }
	.od-amount { font-weight: 800; white-space: nowrap; }
	@@media (max-width: 575.98px) { .od-line { gap: .75rem; } .od-thumb { width: 3.25rem; height: 3.25rem; font-size: 1.1rem; } }
</style>

<section class="hero hero-compact mb-4" aria-labelledby="order-heading">
	<span class="hero-bubble one" aria-hidden="true"></span>
	<div class="position-relative">
		<span class="eyebrow">Orders</span>
		<h1 id="order-heading" class="mb-1">Order #@Model.Summary.Id</h1>
		<p class="lead mb-0">Table @Model.Summary.TableLabel · placed @placed.ToString("d MMM yyyy, h:mm tt")</p>
	</div>
</section>

<section class="tg-card h-auto mb-4" aria-labelledby="status-heading">
	<div class="od-status">
		<div>
			<h2 id="status-heading" class="h5 mb-0">
				Order status
				<span class="badge @DetailsModel.StatusBadgeClass(Model.Summary.Status) ms-2">@DetailsModel.StatusText(Model.Summary.Status)</span>
			</h2>
			@if (Model.Summary.Status == OrderStatus.Placed)
			{
				<p class="od-hint">Your order is in. It will be prepared once you are seated at your table.</p>
			}
			else
			{
				<p class="od-hint">Live progress is on the Track my visit page.</p>
			}
		</div>
		@if (Model.Summary.Status != OrderStatus.Cancelled)
		{
			<a href="/Customer/Tracking" class="btn btn-outline-primary">Track live →</a>
		}
	</div>
</section>

<section class="tg-card h-auto mb-4" aria-labelledby="items-heading">
	<h2 id="items-heading" class="h4 mb-2">Your dishes</h2>
	<ul class="od-list">
		@foreach (Rroms.Web.Models.ViewModels.OrderSummaryLine line in Model.Summary.Lines)
		{
			Rroms.Web.Models.ViewModels.MenuItemCard? dish = Model.DishFor(line);
			<li class="od-line">
				<span class="od-thumb" aria-hidden="true">
					@if (dish != null && !string.IsNullOrEmpty(dish.PhotoUrl))
					{
						<img src="@dish.PhotoUrl" alt="" loading="lazy" />
					}
					else
					{
						@(line.DishName.Length > 0 ? line.DishName.Substring(0, 1).ToUpperInvariant() : "?")
					}
				</span>
				<span class="od-name">
					<strong>@line.DishName</strong>
					<span class="od-meta">
						@if (dish != null && !string.IsNullOrEmpty(dish.Code))
						{
							<span>@dish.Code · </span>
						}
						@Money.Format(line.UnitPrice) each · Quantity @line.Quantity
					</span>
					@if (!string.IsNullOrEmpty(line.Notes))
					{
						<br /><span class="od-note">Note: @line.Notes</span>
					}
				</span>
				<span class="od-amount">@Money.Format(line.LineTotal)</span>
			</li>
		}
	</ul>
</section>

<link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" />
<div class="billing-columns mb-4"><section class="tg-card h-auto" aria-labelledby="bill-heading">
	<h2 id="bill-heading" class="h4 mb-3">Your bill</h2>
	<partial name="_BillBreakdown" model="Model.Summary.Breakdown" />

	@if (!string.IsNullOrEmpty(Model.Summary.Notes))
	{
		<p class="mb-0"><strong>Note for the kitchen:</strong> @Model.Summary.Notes</p>
	}
</section>

<section class="tg-card h-auto"><span class="eyebrow">Payment</span>
@if(Model.PaymentReceipt is { } receipt) {
<h2 class="h4 mt-2 d-flex flex-wrap justify-content-between align-items-center gap-2">Payment <span class="badge text-bg-success">@(receipt.Refund?.Status == RefundStatus.Completed ? "Refunded" : "Paid")</span></h2>
@if(receipt.Refund != null) { <p>Refund status: @receipt.Refund.Status. Open the receipt for details.</p> }<p class="billing-total">@Money.Format(receipt.TotalPaid)</p><p>@Money.Method(receipt.Method)<br />@MalaysiaTime.FromUtc(receipt.PaidAtUtc).ToString("dd MMM yyyy, h:mm tt") (Malaysia)</p><p>Receipt @receipt.Number</p>
@if(receipt.Bills.Count > 1) { <p class="small text-secondary">This receipt covers @receipt.Bills.Count orders from your visit.</p> }
@if(receipt.Method == PaymentMethod.SimulatedOnline) { <p class="alert alert-warning">DEMO ONLY — no real payment processed.</p> }
<div class="d-flex flex-wrap gap-2"><a asp-area="Customer" asp-page="/Receipts/Details" asp-route-id="@receipt.PaymentId" class="btn btn-primary">View receipt</a><a asp-area="Customer" asp-page="/Receipts/Details" asp-route-id="@receipt.PaymentId" asp-page-handler="Pdf" class="btn btn-outline-primary">Download PDF</a></div>
} else if(Model.Summary.Status == OrderStatus.Cancelled) {
<h2 class="h4 mt-2">Order cancelled</h2><p>No payment is due for this cancelled order.</p>
} else {
<h2 class="h4 mt-2 d-flex flex-wrap justify-content-between align-items-center gap-2">Ready when you are <span class="badge text-bg-warning">Unpaid</span></h2><p class="billing-total">@Money.Format(Model.Summary.TotalAmount)</p><p>Please pay at the counter. Your receipt will appear here once payment is recorded.</p>
}
</section></div>
<partial name="_DishSuggestions" model="Model.Together" />

<p>
	<a asp-page="/Reservations/Details" asp-route-id="@Model.Summary.ReservationId">Back to my booking</a>
	·
	<a asp-page="/History/Index">My history</a>
</p>
