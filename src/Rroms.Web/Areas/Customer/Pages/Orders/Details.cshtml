@page "{id:int}"
@model DetailsModel
@using Rroms.Web.Common
@using Rroms.Web.Contracts
@{
	ViewData["Title"] = "My order";
	DateTime placed = MalaysiaTime.FromUtc(Model.Summary.PlacedAtUtc);
}

<section class="hero hero-compact mb-4" aria-labelledby="order-heading">
	<span class="hero-bubble one" aria-hidden="true"></span>
	<div class="position-relative">
		<span class="eyebrow">Orders</span>
		<h1 id="order-heading" class="mb-1">Order #@Model.Summary.Id</h1>
		<p class="lead mb-0">Table @Model.Summary.TableLabel · placed @placed.ToString("d MMM yyyy, h:mm tt")</p>
	</div>
</section>

<link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" />
<div class="billing-columns mb-4"><section class="tg-card h-auto" aria-labelledby="items-heading">
	<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
		<h2 id="items-heading" class="h4 mb-0">Your bill</h2>
		<span class="badge @DetailsModel.StatusBadgeClass(Model.Summary.Status) fs-6">@DetailsModel.StatusText(Model.Summary.Status)</span>
	</div>

	<div class="table-responsive">
		<table class="table align-middle">
			<thead>
				<tr>
					<th scope="col">Dish</th>
					<th scope="col" class="text-end">Quantity</th>
					<th scope="col" class="text-end">Price</th>
					<th scope="col" class="text-end">Total</th>
				</tr>
			</thead>
			<tbody>
				@foreach (Rroms.Web.Models.ViewModels.OrderSummaryLine line in Model.Summary.Lines)
				{
					<tr>
						<th scope="row">
							@line.DishName
							@if (!string.IsNullOrEmpty(line.Notes))
							{
								<div class="small text-secondary fw-normal">Note: @line.Notes</div>
							}
						</th>
						<td class="text-end">@line.Quantity</td>
						<td class="text-end">@Money.Format(line.UnitPrice)</td>
						<td class="text-end">@Money.Format(line.LineTotal)</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<th scope="row" colspan="3" class="text-end">Total</th>
					<td class="text-end fw-bold">@Money.Format(Model.Summary.TotalAmount)</td>
				</tr>
			</tfoot>
		</table>
<partial name="_BillBreakdown" model="Model.Summary.Breakdown" />
	</div>

	@if (!string.IsNullOrEmpty(Model.Summary.Notes))
	{
		<p class="mb-0"><strong>Note for the kitchen:</strong> @Model.Summary.Notes</p>
	}

	@if (Model.Summary.Status == OrderStatus.Placed)
	{
		<p class="text-secondary small mt-3 mb-0">Your order is in. It will be prepared once you are seated at your table.</p>
	}
</section>

<section class="tg-card h-auto"><span class="eyebrow">Payment</span>
@if(Model.PaymentReceipt is { } receipt) {
<h2 class="h4 mt-2">Payment <span class="badge text-bg-success">@(receipt.Refund?.Status == RefundStatus.Completed ? "Refunded" : "Paid")</span></h2>
@if(receipt.Refund != null) { <p>Refund status: @receipt.Refund.Status. Open the receipt for details.</p> }<p class="billing-total">@Money.Format(receipt.TotalPaid)</p><p>@Money.Method(receipt.Method)<br />@MalaysiaTime.FromUtc(receipt.PaidAtUtc).ToString("dd MMM yyyy, h:mm tt") (Malaysia)</p><p>Receipt @receipt.Number</p>
@if(receipt.Bills.Count > 1) { <p class="small text-secondary">This receipt covers @receipt.Bills.Count orders from your visit.</p> }
@if(receipt.Method == PaymentMethod.SimulatedOnline) { <p class="alert alert-warning">DEMO ONLY — no real payment processed.</p> }
<div class="d-flex flex-wrap gap-2"><a asp-area="Customer" asp-page="/Receipts/Details" asp-route-id="@receipt.PaymentId" class="btn btn-primary">View receipt</a><a asp-area="Customer" asp-page="/Receipts/Details" asp-route-id="@receipt.PaymentId" asp-page-handler="Pdf" class="btn btn-outline-primary">Download PDF</a></div>
} else if(Model.Summary.Status == OrderStatus.Cancelled) {
<h2 class="h4 mt-2">Order cancelled</h2><p>No payment is due for this cancelled order.</p>
} else {
<h2 class="h4 mt-2">Ready when you are <span class="badge text-bg-warning">Unpaid</span></h2><p class="billing-total">@Money.Format(Model.Summary.TotalAmount)</p><p>Please pay at the counter. Your receipt will appear here once payment is recorded.</p>
}
</section></div>
<partial name="_DishSuggestions" model="Model.Together" />

<p>
	<a asp-page="/Reservations/Details" asp-route-id="@Model.Summary.ReservationId">Back to my booking</a>
	·
	<a asp-page="/History/Index">My history</a>
</p>
