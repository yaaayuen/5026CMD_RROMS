@page "{reservationId:int}"
@model NewModel
@inject Microsoft.Extensions.Options.IOptions<Rroms.Web.Options.BillingOptions> BillingRates
@using System.Globalization
@using Rroms.Web.Common
@using Rroms.Web.Models.ViewModels
@{
	ViewData["Title"] = "Order food";

	// Only dishes that can be ordered get a quantity box. Their rows must be numbered 0, 1, 2, ... with no gaps,
	// because ASP.NET Core stops reading a list at the first missing number.
	List<MenuItemCard> orderable = Model.Dishes.Where(dish => dish.CanOrder).ToList();
	List<IGrouping<string, MenuItemCard>> categories = Model.Dishes.GroupBy(dish => dish.CategoryName).ToList();
}

<style>
	.ox-page {
		padding-bottom: 6.5rem;
	}

	.ox-num {
		font-variant-numeric: lining-nums tabular-nums;
	}

	.ox-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.ox-pill {
		background: rgba(255, 255, 255, 0.22);
		border-radius: var(--tg-radius-pill);
		padding: 0.3rem 0.85rem;
		font-weight: 700;
	}

	.ox-diet-banner {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		align-items: center;
		background: var(--tg-peach);
		border-left: 5px solid var(--tg-coral);
		border-radius: 0.75rem;
		padding: 0.75rem 1rem;
		margin-bottom: 1.5rem;
	}

		.ox-diet-banner a {
			font-weight: 700;
		}

	.ox-chips {
		position: sticky;
		top: 0;
		z-index: 1020;
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding: 0.6rem 0;
		margin-bottom: 1rem;
		background: var(--tg-cream);
	}

	.ox-chip {
		white-space: nowrap;
		border: 1px solid var(--bs-border-color);
		border-radius: var(--tg-radius-pill);
		padding: 0.35rem 1rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--tg-ink);
		background: var(--tg-surface);
	}

		.ox-chip:hover {
			border-color: var(--tg-raspberry);
			color: var(--tg-link);
		}

		.ox-chip.is-active {
			background: var(--tg-raspberry);
			border-color: var(--tg-raspberry);
			color: var(--tg-on-brand);
		}

	.ox-cat {
		scroll-margin-top: 4.5rem;
	}

	.ox-rec .ox-add {
		border: 2px solid var(--tg-link);
		background: transparent;
		color: var(--tg-link);
		border-radius: var(--tg-radius-pill);
		font-weight: 700;
		padding: 0.2rem 0.9rem;
	}

		.ox-rec .ox-add:hover {
			background: var(--tg-blush);
		}

	.ox-dish {
		display: flex;
		flex-direction: column;
	}

		.ox-dish.has-warning {
			border: 2px solid var(--tg-coral);
		}

		.ox-dish.is-in {
			box-shadow: 0 0 0 3px var(--tg-raspberry), var(--tg-shadow);
		}

	.ox-photo {
		position: relative;
		height: 12rem;
		margin-bottom: 1rem;
		border-radius: var(--bs-border-radius);
		overflow: hidden;
		background: var(--tg-gradient);
		display: grid;
		place-items: center;
	}

		.ox-photo img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

	.ox-ph {
		font-family: var(--tg-font-heading);
		font-size: 3rem;
		font-weight: 800;
		color: rgba(255, 255, 255, 0.85);
	}

	.ox-offer {
		position: absolute;
		top: 0.6rem;
		left: 0.6rem;
		background: var(--tg-gold);
		color: var(--tg-on-gold);
		font-size: 0.75rem;
		font-weight: 800;
		border-radius: var(--tg-radius-pill);
		padding: 0.2rem 0.65rem;
	}

	.ox-body {
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
	}

	.ox-desc {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.ox-tag-avoid {
		border-color: var(--tg-coral) !important;
	}

	.ox-warn {
		color: #9a4a10;
		font-weight: 700;
		font-size: 0.9rem;
	}

	[data-bs-theme="dark"] .ox-warn {
		color: #ffb27a;
	}

	.ox-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.ox-step {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--bs-border-color);
		border-radius: var(--tg-radius-pill);
		overflow: hidden;
		background: var(--tg-surface);
	}

	.ox-stepbtn {
		width: 2.4rem;
		height: 2.4rem;
		border: 0;
		background: var(--tg-blush);
		color: var(--tg-link);
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1;
	}

		.ox-stepbtn:hover {
			background: var(--tg-raspberry);
			color: var(--tg-on-brand);
		}

	.ox-qty {
		width: 3rem;
		border: 0;
		text-align: center;
		font-weight: 800;
		background: transparent;
		color: var(--tg-ink);
		-moz-appearance: textfield;
		font-variant-numeric: lining-nums tabular-nums;
	}

		.ox-qty::-webkit-outer-spin-button, .ox-qty::-webkit-inner-spin-button {
			-webkit-appearance: none;
			margin: 0;
		}

	.ox-link {
		border: 0;
		background: transparent;
		padding: 0;
		color: var(--tg-link);
		font-weight: 700;
		text-decoration: underline;
	}

	.ox-step-sm .ox-stepbtn {
		width: 1.9rem;
		height: 1.9rem;
	}

	.ox-line-qty {
		min-width: 1.6rem;
		text-align: center;
		font-weight: 800;
	}

	/* Lift the "Ask Three Grills" chat button above the order bar so the two never overlap on this page. */
	.chat-launcher {
		bottom: 4.75rem !important;
	}

	.ox-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1030;
		background: var(--tg-surface);
		box-shadow: 0 -8px 24px rgba(43, 45, 66, 0.15);
		border-top: 3px solid var(--tg-raspberry);
	}

	.ox-bar-in {
		max-width: 1140px;
		margin: 0 auto;
		padding: 0.7rem 1rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.ox-bar-sum {
		flex: 1 1 auto;
		display: flex;
		align-items: center;
		gap: 1rem;
		border: 0;
		background: transparent;
		color: var(--tg-ink);
		text-align: left;
		font-weight: 700;
	}

	.ox-bar-total {
		font-size: 1.25rem;
		font-weight: 800;
	}

	.ox-bar-view {
		color: var(--tg-link);
		text-decoration: underline;
	}

	.ox-drawer, .ox-modal {
		border: 0;
		padding: 0;
		color: var(--tg-ink);
		background: var(--tg-surface);
		box-shadow: var(--tg-shadow-hover);
	}

		.ox-drawer::backdrop, .ox-modal::backdrop {
			background: rgba(20, 20, 31, 0.55);
		}

	.ox-drawer {
		margin: 0 0 0 auto;
		height: 100vh;
		max-height: 100vh;
		width: min(26rem, 100vw);
		border-radius: var(--tg-radius) 0 0 var(--tg-radius);
	}

		.ox-drawer[open] {
			display: flex;
			flex-direction: column;
		}

	.ox-drawer-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid var(--bs-border-color);
	}

	.ox-drawer-scroll {
		flex: 1 1 auto;
		overflow-y: auto;
		padding: 0 1.5rem;
	}

	.ox-drawer-foot {
		padding: 1.25rem 1.5rem 1.5rem;
		background: var(--tg-cream);
		border-top: 1px solid var(--bs-border-color);
	}

	.ox-total-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

		.ox-total-row strong {
			font-family: var(--tg-font-heading);
			font-size: 1.75rem;
		}

	.ox-place {
		width: 100%;
		border: 0;
		border-radius: var(--tg-radius-pill);
		padding: 0.8rem 1.4rem;
		font-weight: 700;
		color: var(--tg-on-brand);
		background: linear-gradient(120deg, var(--tg-raspberry), var(--tg-coral));
		box-shadow: 0 6px 16px rgba(216, 17, 89, 0.25);
	}

		.ox-place:disabled {
			opacity: 0.7;
		}

	.ox-modal {
		width: min(30rem, 92vw);
		border-radius: var(--tg-radius);
	}

	.ox-modal-in {
		position: relative;
		padding: 1.5rem;
	}

	.ox-modal-photo {
		margin: -1.5rem -1.5rem 1rem;
		height: 12rem;
		overflow: hidden;
	}

		.ox-modal-photo img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

	.ox-close {
		border: 0;
		background: var(--tg-blush);
		color: var(--tg-link);
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 50%;
		font-size: 1.3rem;
		line-height: 1;
	}

	.ox-modal-x {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		z-index: 1;
	}

	.ox-lines {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.ox-line {
		display: grid;
		grid-template-columns: 3.25rem 1fr auto;
		column-gap: 0.75rem;
		row-gap: 0.25rem;
		align-items: start;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--bs-border-color);
	}

	.ox-line-thumb {
		grid-row: 1 / span 2;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--tg-gradient);
		color: rgba(255, 255, 255, 0.9);
		display: grid;
		place-items: center;
		font-family: var(--tg-font-heading);
		font-size: 1.4rem;
		font-weight: 800;
	}

		.ox-line-thumb img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

	.ox-line-info {
		grid-row: 1 / span 2;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.ox-line-name {
		font-weight: 700;
	}

	.ox-line-meta {
		font-size: 0.85rem;
		color: var(--tg-muted);
	}

		.ox-line-meta s {
			margin-left: 0.2rem;
		}

	.ox-line-note {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--tg-link);
	}

	.ox-line-amt {
		grid-column: 3;
		grid-row: 1;
		text-align: right;
		font-weight: 800;
	}

	.ox-line .ox-step {
		grid-column: 3;
		grid-row: 2;
		justify-self: end;
	}

	@@media (max-width: 575.98px) {
		.ox-bar-view {
			display: none;
		}

		.ox-bar-cancel {
			display: none;
		}

		.ox-drawer {
			width: 100vw;
			border-radius: 0;
		}
	}

	@@media (prefers-reduced-motion: reduce) {
		.ox-dish {
			transition: none;
		}
	}
</style>

<section class="hero hero-compact mb-4" aria-labelledby="order-heading">
	<span class="hero-bubble one" aria-hidden="true"></span>
	<div class="position-relative">
		<span class="eyebrow">Order</span>
		<h1 id="order-heading" class="mb-1">Order food</h1>
		@if (Model.Reservation != null)
		{
			DateTime start = MalaysiaTime.FromUtc(Model.Reservation.StartUtc);
			<p class="ox-pills mb-0">
				<span class="ox-pill">Table @Model.Reservation.TableLabel</span>
				<span class="ox-pill">@Model.Reservation.AreaName</span>
				<span class="ox-pill">@start.ToString("ddd d MMM, h:mm tt")</span>
			</p>
		}
	</div>
</section>

@if (Model.Reservation == null)
{
	<section class="tg-card h-auto" aria-labelledby="not-yet-heading">
		<h2 id="not-yet-heading" class="h4 mb-3">You cannot order yet</h2>
		<p>@Model.NotOrderableMessage</p>
		<a class="btn btn-primary" asp-page="/Reservations/Index">Back to my reservations</a>
	</section>
}
else
{
	<div class="ox-page">
		<form method="post" id="orderForm" novalidate>
			<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

			<p class="text-secondary">
				Your food is prepared once you are seated at your table. You can order now and we will have it ready for you.
			</p>

			@if (Model.AvoidedTagNames.Count > 0)
			{
				<div class="ox-diet-banner" role="note">
					<strong>Your profile avoids: @string.Join(", ", Model.AvoidedTagNames.OrderBy(name => name))</strong>
					<span>Dishes that contain these are marked with a warning. This is a guide only, so please tell our staff about any allergy.</span>
					<a href="/Account/Profile">Change my dietary preferences</a>
				</div>
			}

			@if (Model.Recommended.Items.Count > 0)
			{
				<section class="mb-4" aria-labelledby="suggest-@Model.Recommended.Key">
					<h2 id="suggest-@Model.Recommended.Key" class="section-title h3 mb-3">@Model.Recommended.Heading</h2>

					<div class="row g-3">
						@foreach (DishRecommendation item in Model.Recommended.Items)
						{
							bool canAdd = orderable.Any(dish => dish.Id == item.Dish.Id);

							<div class="col-sm-6 col-lg-3">
								<article class="tg-card h-100 ox-rec">
									<h3 class="h6 mb-1">
										@if (!string.IsNullOrEmpty(item.Dish.Code))
										{
											<span class="small fw-semibold text-secondary me-2">@item.Dish.Code</span>
										}
										@item.Dish.Name
									</h3>
									<p class="mb-1 ox-num">
										@if (item.Dish.IsOfferActive)
										{
											<span class="text-decoration-line-through text-secondary">RM @item.Dish.NormalPrice.ToString("N2")</span>
										}
										<strong>RM @item.Dish.CurrentPrice.ToString("N2")</strong>
									</p>
									<p class="small text-secondary mb-2">@item.Reason</p>
									@if (canAdd)
									{
										<button type="button" class="ox-add" data-add="@item.Dish.Id">+ Add</button>
									}
								</article>
							</div>
						}
					</div>
				</section>
			}

			<nav class="ox-chips" id="oxChips" aria-label="Menu categories">
				@for (int c = 0; c < categories.Count; c++)
				{
					<a href="#cat-@c" class="ox-chip">@categories[c].Key</a>
				}
			</nav>

			@for (int c = 0; c < categories.Count; c++)
			{
				IGrouping<string, MenuItemCard> group = categories[c];

				<section class="mb-4 ox-cat" id="cat-@c" aria-label="@group.Key">
					<h2 class="section-title h3 mb-3">@group.Key</h2>

					<div class="row g-3">
						@foreach (MenuItemCard dish in group)
						{
							int row = orderable.IndexOf(dish);
							IReadOnlyList<string> avoided = Model.AvoidedIn(dish);
							string initial = string.IsNullOrEmpty(dish.Name) ? "?" : dish.Name.Substring(0, 1).ToUpperInvariant();

							<div class="col-sm-6 col-lg-4">
								<article class="tg-card ox-dish h-100 @(dish.CanOrder ? "" : "opacity-75") @(avoided.Count > 0 ? "has-warning" : "")"
										 data-dish="@dish.Id"
										 data-name="@dish.Name"
										 data-code="@dish.Code"
										 data-desc="@dish.Description"
										 data-photo="@dish.PhotoUrl"
										 data-price-text="RM @dish.CurrentPrice.ToString("N2")"
										 data-was="@(dish.IsOfferActive ? "RM " + dish.NormalPrice.ToString("N2") : "")"
										 data-tags="@string.Join("|", dish.DietaryTags)"
										 data-avoid="@string.Join("|", avoided)"
										 data-can-order="@(dish.CanOrder ? "1" : "0")">
									<div class="ox-photo">
										@if (!string.IsNullOrEmpty(dish.PhotoUrl))
										{
											<img src="@dish.PhotoUrl" alt="" loading="lazy" />
										}
										else
										{
											<span class="ox-ph" aria-hidden="true">@initial</span>
										}
										@if (dish.IsOfferActive)
										{
											<span class="ox-offer">Offer</span>
										}
									</div>

									<div class="ox-body">
										<h3 class="h5 mb-1">
											@if (!string.IsNullOrEmpty(dish.Code))
											{
												<span class="small fw-semibold text-secondary me-2">@dish.Code</span>
											}
											@dish.Name
										</h3>
										<p class="text-secondary small mb-2 ox-desc">@dish.Description</p>

										<p class="mb-1 ox-num">
											@if (dish.IsOfferActive)
											{
												<span class="text-decoration-line-through text-secondary">RM @dish.NormalPrice.ToString("N2")</span>
												<strong>RM @dish.CurrentPrice.ToString("N2")</strong>
											}
											else
											{
												<strong>RM @dish.CurrentPrice.ToString("N2")</strong>
											}
										</p>

										@if (dish.DietaryTags.Count > 0)
										{
											<p class="mb-1">
												@foreach (string tagName in dish.DietaryTags)
												{
													<span class="badge text-bg-light border @(avoided.Contains(tagName) ? "ox-tag-avoid" : "")">@tagName</span>
												}
											</p>
										}

										@if (avoided.Count > 0)
										{
											<p class="ox-warn mb-1">&#9888; Contains @string.Join(", ", avoided) (on your avoid list)</p>
										}

										<div class="ox-actions">
											@if (dish.CanOrder)
											{
												<input type="hidden" name="Lines[@row].MenuItemId" value="@dish.Id" />
												<label for="quantity-@dish.Id" class="visually-hidden">Quantity of @dish.Name</label>
												<div class="ox-step" role="group" aria-label="Quantity of @dish.Name">
													<button type="button" class="ox-stepbtn" data-step="-1" data-target="quantity-@dish.Id" aria-label="One less @dish.Name">&minus;</button>
													<input id="quantity-@dish.Id" type="number" name="Lines[@row].Quantity" class="ox-qty"
														   min="0" max="@Model.MaxQuantity" value="@Model.QuantityFor(dish.Id)" inputmode="numeric"
														   data-price="@dish.CurrentPrice.ToString(CultureInfo.InvariantCulture)" data-name="@dish.Name" />
													<button type="button" class="ox-stepbtn" data-step="1" data-target="quantity-@dish.Id" aria-label="One more @dish.Name">+</button>
												</div>
												<button type="button" class="ox-link" data-note-toggle="note-@dish.Id">Add a note</button>
											}
											else
											{
												<span class="badge text-bg-secondary">Unavailable</span>
											}
											<button type="button" class="ox-link ms-auto" data-detail="@dish.Id">Details</button>
										</div>

										@if (dish.CanOrder)
										{
											string existingNote = Model.NoteFor(dish.Id);

											<div class="ox-note" id="note-wrap-@dish.Id" @(string.IsNullOrEmpty(existingNote) ? "hidden" : "")>
												<label for="note-@dish.Id" class="visually-hidden">Note for @dish.Name</label>
												<input id="note-@dish.Id" type="text" name="Lines[@row].Notes" class="form-control form-control-sm mt-2"
													   maxlength="@Model.MaxLineNoteLength" placeholder="Note for this dish (optional)" value="@existingNote" />
											</div>
										}
									</div>
								</article>
							</div>
						}
					</div>
				</section>
			}

			<div class="ox-bar" id="orderBar" role="region" aria-label="Your order">
				<div class="ox-bar-in">
					<button type="button" class="ox-bar-sum" id="openDrawer" aria-haspopup="dialog">
						<span class="ox-bar-count"><span id="orderCount">0</span> items</span>
						<span class="ox-bar-total ox-num">RM <span id="orderTotal">0.00</span></span>
						<span class="ox-bar-view">View order · includes charges</span>
					</button>
					<a class="btn btn-link ox-bar-cancel" asp-page="/Reservations/Details" asp-route-id="@Model.Reservation.Id">Cancel</a>
					<button type="submit" id="placeOrder" class="btn btn-primary">Place order</button>
				</div>
			</div>

			<dialog id="orderDrawer" class="ox-drawer" aria-labelledby="summary-heading">
				<div class="ox-drawer-head">
					<h2 id="summary-heading" class="h4 mb-0">Your order</h2>
					<button type="button" class="ox-close" data-close-drawer aria-label="Close your order">&times;</button>
				</div>

				<div class="ox-drawer-scroll">
					<ul class="ox-lines" id="drawerLines" aria-live="polite"></ul>
					<p class="text-secondary" id="drawerEmpty">Nothing yet. Use + on a dish to add it.</p>
				</div>

				<div class="ox-drawer-foot">
					<label asp-for="Notes" class="form-label fw-semibold small mb-1">Note for the kitchen (optional)</label>
					<textarea asp-for="Notes" class="form-control mb-3" rows="2" maxlength="@Model.MaxOrderNoteLength" placeholder="e.g. allergic to peanuts"></textarea>

					<div class="small mb-3" aria-live="polite" aria-atomic="true">
                        <div class="d-flex justify-content-between gap-3 mb-2"><span>Subtotal</span><span class="ox-num">RM <span id="orderSubtotal">0.00</span></span></div>
                        <div class="d-flex justify-content-between gap-3 mb-2"><span>Service charge (@BillingRates.Value.ServiceChargePercent.ToString("0.##")%)</span><span class="ox-num">RM <span id="orderServiceCharge">0.00</span></span></div>
                        <div class="d-flex justify-content-between gap-3"><span>Service tax (@BillingRates.Value.ServiceTaxPercent.ToString("0.##")%)</span><span class="ox-num">RM <span id="orderServiceTax">0.00</span></span></div>
                    </div>
                    <div class="ox-total-row" aria-live="polite">
						<span>Estimated total</span>
						<strong class="ox-num">RM <span id="drawerTotal">0.00</span></strong>
					</div>
					<p class="text-secondary small">Includes service charge and tax. Tax applies to @(BillingRates.Value.TaxIncludesServiceCharge ? "subtotal plus service charge" : "subtotal"). The final total uses current prices when you place the order.</p>

					<button type="submit" class="ox-place" id="placeOrderDrawer">Place order &rarr;</button>
				</div>
			</dialog>
		</form>

		<dialog id="dishDialog" class="ox-modal" aria-labelledby="dishDialogTitle">
			<div class="ox-modal-in">
				<button type="button" class="ox-close ox-modal-x" data-close-dish aria-label="Close dish details">&times;</button>
				<div class="ox-modal-photo" id="dishDialogPhoto"></div>
				<h2 id="dishDialogTitle" class="h4 mb-1"></h2>
				<p class="small fw-semibold text-secondary mb-2" id="dishDialogCode"></p>
				<p class="mb-2" id="dishDialogDesc"></p>
				<p class="mb-2 ox-num"><span class="text-decoration-line-through text-secondary" id="dishDialogWas"></span> <strong id="dishDialogPrice"></strong></p>
				<p class="mb-2" id="dishDialogTags"></p>
				<p class="ox-warn mb-3" id="dishDialogWarn" hidden></p>
				<button type="button" class="btn btn-primary" id="dishDialogAdd">+ Add to order</button>
			</div>
		</dialog>
	</div>
}

@section Scripts {
	<script>
		(function () {
			var form = document.getElementById('orderForm');

			if (!form) {
				return;
			}

			var inputs = [].slice.call(document.querySelectorAll('input[data-price]'));
			var totalElement = document.getElementById('orderTotal');
			var countElement = document.getElementById('orderCount');
			var drawerTotal = document.getElementById('drawerTotal');
			var drawer = document.getElementById('orderDrawer');
			var drawerLines = document.getElementById('drawerLines');
			var drawerEmpty = document.getElementById('drawerEmpty');
			var dishDialog = document.getElementById('dishDialog');
			var buttons = [document.getElementById('placeOrder'), document.getElementById('placeOrderDrawer')];
			var currentDishId = null;
            var chargeRate = @BillingRates.Value.ServiceChargePercent.ToString(CultureInfo.InvariantCulture);
            var taxRate = @BillingRates.Value.ServiceTaxPercent.ToString(CultureInfo.InvariantCulture);
            var taxIncludesCharge = @BillingRates.Value.TaxIncludesServiceCharge.ToString().ToLowerInvariant();
            // Percentages have at most two decimal places; use integer basis points and cents.
            var chargeBasisPoints = Math.round(chargeRate * 100);
            var taxBasisPoints = Math.round(taxRate * 100);

			function byId(id) {
				return document.getElementById(id);
			}

			function quantity(input) {
				return Math.max(0, parseInt(input.value, 10) || 0);
			}

			function setQuantity(input, value) {
				var max = parseInt(input.max, 10) || 99;
				input.value = Math.min(Math.max(value, 0), max);
				input.dispatchEvent(new Event('input', { bubbles: true }));
			}

			function money(value) {
				return value.toFixed(2);
			}

			function makeStepButton(label, step, targetId, text) {
				var b = document.createElement('button');
				b.type = 'button';
				b.className = 'ox-stepbtn';
				b.setAttribute('data-step', step);
				b.setAttribute('data-target', targetId);
				b.setAttribute('aria-label', label);
				b.textContent = text;
				return b;
			}

			// Only a convenience for the customer: the server works out the real total itself.
			function update() {
				var total = 0;
				var count = 0;

				while (drawerLines.firstChild) {
					drawerLines.removeChild(drawerLines.firstChild);
				}

				inputs.forEach(function (input) {
					var q = quantity(input);
					var price = parseFloat(input.dataset.price) || 0;
					var card = input.closest('.ox-dish');

					if (card) {
						card.classList.toggle('is-in', q > 0);
					}

					if (q > 0) {
						total += q * Math.round(price * 100);
						count += q;

						var li = document.createElement('li');
						var info = document.createElement('span');
						var nameLine = document.createElement('span');
						var meta = document.createElement('span');
						var amount = document.createElement('span');
						var step = document.createElement('span');

						li.className = 'ox-line';
						info.className = 'ox-line-info';
						nameLine.className = 'ox-line-name';
						nameLine.textContent = input.dataset.name;
						info.appendChild(nameLine);

						// "S01 · RM 13.00", with the old price struck through while an offer runs.
						meta.className = 'ox-line-meta ox-num';
						var parts = [];
						if (card && card.dataset.code) {
							parts.push(card.dataset.code);
						}
						parts.push(card && card.dataset.priceText ? card.dataset.priceText : 'RM ' + money(price));
						meta.appendChild(document.createTextNode(parts.join(' \u00B7 ')));
						if (card && card.dataset.was) {
							var was = document.createElement('s');
							was.textContent = card.dataset.was;
							meta.appendChild(document.createTextNode(' '));
							meta.appendChild(was);
						}
						info.appendChild(meta);

						// Show the note the customer typed for this dish, so they can check it before ordering.
						var noteInput = byId(input.id.replace('quantity-', 'note-'));
						if (noteInput && noteInput.value.trim() !== '') {
							var note = document.createElement('span');
							note.className = 'ox-line-note';
							note.textContent = 'Note: ' + noteInput.value.trim();
							info.appendChild(note);
						}

						amount.className = 'ox-line-amt ox-num';
						amount.textContent = 'RM ' + money(q * price);
						step.className = 'ox-step ox-step-sm';
						step.appendChild(makeStepButton('One less ' + input.dataset.name, '-1', input.id, '\u2212'));

						var number = document.createElement('span');
						number.className = 'ox-line-qty';
						number.textContent = q;
						step.appendChild(number);
						step.appendChild(makeStepButton('One more ' + input.dataset.name, '1', input.id, '+'));

						// The dish photo (or its first letter when it has none), like on the dish card.
						var thumb = document.createElement('span');
						thumb.className = 'ox-line-thumb';
						if (card && card.dataset.photo) {
							var img = document.createElement('img');
							img.src = card.dataset.photo;
							img.alt = '';
							thumb.appendChild(img);
						} else {
							thumb.textContent = input.dataset.name.substring(0, 1).toUpperCase();
						}

						li.appendChild(thumb);
						li.appendChild(info);
						li.appendChild(amount);
						li.appendChild(step);
						drawerLines.appendChild(li);
					}
				});

				var chargeCents = Math.floor((total * chargeBasisPoints + 5000) / 10000);
                var taxBaseCents = total + (taxIncludesCharge ? chargeCents : 0);
                var taxCents = Math.floor((taxBaseCents * taxBasisPoints + 5000) / 10000);
                var finalTotal = (total + chargeCents + taxCents) / 100;
                byId('orderSubtotal').textContent = money(total / 100);
                byId('orderServiceCharge').textContent = money(chargeCents / 100);
                byId('orderServiceTax').textContent = money(taxCents / 100);
                totalElement.textContent = money(finalTotal);
                drawerTotal.textContent = money(finalTotal);
				countElement.textContent = count;
				drawerEmpty.hidden = count > 0;
			}

			inputs.forEach(function (input) {
				input.addEventListener('input', update);
			});

			[].slice.call(document.querySelectorAll('input[id^="note-"]')).forEach(function (noteInput) {
				noteInput.addEventListener('input', update);
			});

			function openDish(card) {
				currentDishId = card.dataset.dish;
				byId('dishDialogTitle').textContent = card.dataset.name;
				byId('dishDialogCode').textContent = card.dataset.code;
				byId('dishDialogDesc').textContent = card.dataset.desc;
				byId('dishDialogPrice').textContent = card.dataset.priceText;
				byId('dishDialogWas').textContent = card.dataset.was;

				var photo = byId('dishDialogPhoto');
				while (photo.firstChild) {
					photo.removeChild(photo.firstChild);
				}
				if (card.dataset.photo) {
					var img = document.createElement('img');
					img.src = card.dataset.photo;
					img.alt = '';
					photo.appendChild(img);
					photo.hidden = false;
				} else {
					photo.hidden = true;
				}

				var tags = byId('dishDialogTags');
				while (tags.firstChild) {
					tags.removeChild(tags.firstChild);
				}
				(card.dataset.tags ? card.dataset.tags.split('|') : []).forEach(function (tag) {
					var s = document.createElement('span');
					s.className = 'badge text-bg-light border';
					s.textContent = tag;
					tags.appendChild(s);
				});

				var warn = byId('dishDialogWarn');
				if (card.dataset.avoid) {
					warn.textContent = '⚠ Contains ' + card.dataset.avoid.split('|').join(', ') + ', a tag you chose to avoid.';
					warn.hidden = false;
				} else {
					warn.hidden = true;
				}

				byId('dishDialogAdd').hidden = card.dataset.canOrder !== '1';

				if (dishDialog.showModal) {
					dishDialog.showModal();
				}
			}

			document.addEventListener('click', function (event) {
				var el = event.target.closest('[data-step],[data-add],[data-note-toggle],[data-detail],[data-close-drawer],[data-close-dish]');

				if (!el) {
					return;
				}

				if (el.hasAttribute('data-step')) {
					var target = byId(el.dataset.target);
					if (target) {
						setQuantity(target, quantity(target) + parseInt(el.dataset.step, 10));
					}
				} else if (el.hasAttribute('data-add')) {
					var add = byId('quantity-' + el.dataset.add);
					if (add) {
						setQuantity(add, quantity(add) + 1);
					}
				} else if (el.hasAttribute('data-note-toggle')) {
					var wrap = byId(el.dataset.noteToggle.replace('note-', 'note-wrap-'));
					if (wrap) {
						wrap.hidden = !wrap.hidden;
						if (!wrap.hidden) {
							byId(el.dataset.noteToggle).focus();
						}
					}
				} else if (el.hasAttribute('data-detail')) {
					var card = document.querySelector('.ox-dish[data-dish="' + el.dataset.detail + '"]');
					if (card) {
						openDish(card);
					}
				} else if (el.hasAttribute('data-close-drawer')) {
					drawer.close();
				} else if (el.hasAttribute('data-close-dish')) {
					dishDialog.close();
				}
			});

			byId('dishDialogAdd').addEventListener('click', function () {
				var input = byId('quantity-' + currentDishId);
				if (input) {
					setQuantity(input, quantity(input) + 1);
				}
				dishDialog.close();
			});

			byId('openDrawer').addEventListener('click', function () {
				if (drawer.showModal) {
					drawer.showModal();
				}
			});

			// A click on the dimmed area (the dialog itself, not its content) closes it.
			[drawer, dishDialog].forEach(function (dlg) {
				dlg.addEventListener('click', function (event) {
					if (event.target === dlg) {
						dlg.close();
					}
				});
			});

			// Highlight the category chip of the section being read.
			var sections = [].slice.call(document.querySelectorAll('.ox-cat'));
			var chips = [].slice.call(document.querySelectorAll('.ox-chip'));
			if ('IntersectionObserver' in window && sections.length > 0) {
				var observer = new IntersectionObserver(function (entries) {
					entries.forEach(function (entry) {
						if (entry.isIntersecting) {
							chips.forEach(function (chip) {
								chip.classList.toggle('is-active', chip.getAttribute('href') === '#' + entry.target.id);
							});
						}
					});
				}, { rootMargin: '-20% 0px -70% 0px' });
				sections.forEach(function (section) { observer.observe(section); });
			}

			update();

			// A second click on a slow connection must not place the order twice.
			form.addEventListener('submit', function (event) {
                if (form.dataset.submitting === 'true') { event.preventDefault(); return; }
                form.dataset.submitting = 'true';
				buttons.forEach(function (b) {
					if (b) {
						b.disabled = true;
					}
				});
			});
            window.addEventListener('pageshow', function () {
                delete form.dataset.submitting;
                buttons.forEach(function (button) { if (button) button.disabled = false; });
                update();
            });
        })();
	</script>
}
