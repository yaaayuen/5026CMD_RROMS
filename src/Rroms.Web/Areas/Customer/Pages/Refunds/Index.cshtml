@page
@model Rroms.Web.Areas.Customer.Pages.Refunds.IndexModel
@using Rroms.Web.Contracts
@{ ViewData["Title"] = "My refund records"; ViewData["CustomerRefunds"] = true; }
<section class="hero hero-compact mb-4"><span class="eyebrow">Payments</span><h1>@ViewData["Title"]</h1><p>Requests and full refunds, with the original receipt kept for your records.</p></section>
<section class="tg-card h-auto"><form method="get" class="d-flex gap-2 mb-3"><label asp-for="Status" class="visually-hidden">Refund status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<RefundStatus>()" class="form-select"><option value="">All statuses</option></select><button class="btn btn-primary">Filter</button></form><partial name="~/Pages/Shared/_RefundHistory.cshtml" model="Model.Refunds" /></section>
<p class="mt-3"><a asp-page="/History/Index">Back to my history</a></p>
