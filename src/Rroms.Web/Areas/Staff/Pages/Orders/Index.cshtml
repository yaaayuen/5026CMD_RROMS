@page
@model Rroms.Web.Areas.Staff.Pages.Orders.IndexModel
@{ ViewData["Title"] = "Kitchen orders"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h1 class="mb-0">Kitchen orders</h1>
    <button type="button" id="kitchen-sound" class="btn btn-sm btn-outline-primary" aria-pressed="false">Sound alerts: off</button>
</div>
<p class="mt-2">Pre-orders appear here only after staff seat the customer. Cooking starts and finishes automatically,
    up to @Model.Board.CookingSlots orders at a time; staff serve, complete or cancel.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<p id="dining-refresh-state" class="text-muted" role="status">Updates automatically every 5 seconds.</p>
<div id="dining-live-content" data-refresh-url="@Url.Page("/Orders/Index", "Queue", new { area = "Staff" })" data-kitchen="true">
    <partial name="_Queue" model="Model" />
</div>
@section Scripts { <script src="~/js/dining-live.js" asp-append-version="true"></script> }
