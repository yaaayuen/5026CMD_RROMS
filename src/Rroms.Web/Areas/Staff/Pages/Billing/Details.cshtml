@page "{id:int}"
@using Rroms.Web.Common
@model Rroms.Web.Areas.Staff.Pages.Billing.DetailsModel
@using Rroms.Web.Contracts
@using Rroms.Web.Services
@{
    ViewData["Title"] = "Bill for order #" + Model.Bill.OrderId;
}
<section class="hero hero-compact mb-4">
    <span class="eyebrow">Three Grills · Bill</span>
    <h1>Order #@Model.Bill.OrderId</h1>
    <p class="lead mb-0">@Model.Bill.CustomerName · Table @Model.Bill.TableLabel</p>
</section>
<link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" />
<div class="billing-columns mb-4"><section class="tg-card h-auto">
    <partial name="~/Pages/Shared/_BillingLines.cshtml" model="Model.Bill" />
    <p class="h4 text-end">Bill total: @Money.Format(Model.Bill.TotalAmount)</p>
</section><section class="tg-card h-auto">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (Model.Bill.PaidPaymentId.HasValue)
    {
        <div class="alert alert-success">This order has already been paid.</div>
        <a asp-page="Receipt" asp-route-id="@Model.Bill.PaidPaymentId" class="btn btn-primary">Open receipt</a>
    }
    else if (Model.Bill.Status != OrderStatus.Completed)
    {
        <div class="alert alert-warning">@BillingService.NotCompletedMessage Current status: @Model.Bill.Status.</div><a asp-area="Staff" asp-page="/Orders/Index" class="btn btn-outline-primary">Kitchen orders</a>
    }
    else if (Model.UnpaidOrdersOnVisit > 1)
    {
        <div class="alert alert-info">This table has @Model.UnpaidOrdersOnVisit unpaid orders. They are paid together on one bill.</div>
        <a asp-page="Visit" asp-route-id="@Model.Bill.ReservationId" class="btn btn-primary w-100">Take payment for the table</a>
    }
    else
    {
            <partial name="~/Pages/Shared/_TakePayment.cshtml" model="Model.Bill.TotalAmount" />
    }
</section></div>
<a asp-page="Index">Back to billing</a>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/billing.js" asp-append-version="true"></script>
}
