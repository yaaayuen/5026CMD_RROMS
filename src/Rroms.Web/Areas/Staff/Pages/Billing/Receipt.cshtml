@page "{id:int}"
@model Rroms.Web.Areas.Staff.Pages.Billing.ReceiptModel
@{
    ViewData["Title"] = "Receipt #" + Model.Receipt.PaymentId;
}
<link rel="stylesheet" href="~/css/billing-print.css" asp-append-version="true" />
@if (TempData["BillingWarning"] is string warning)
{
    <div class="alert alert-warning d-print-none" role="alert">@warning</div>
}
<partial name="~/Pages/Shared/_PaymentReceipt.cshtml" model="Model.Receipt" />
<div class="d-flex gap-2 mt-3 d-print-none">
    <button type="button" class="btn btn-primary" onclick="window.print()">Print receipt</button>
    <a asp-page="Index" class="btn btn-outline-primary">Back to billing</a>
</div>
