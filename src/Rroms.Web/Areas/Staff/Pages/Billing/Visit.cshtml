@page "{id:int}"
@model Rroms.Web.Areas.Staff.Pages.Billing.VisitModel
@using Rroms.Web.Contracts
@using Rroms.Web.Services
@{
    ViewData["Title"] = "Bill for visit #" + Model.Visit.ReservationId;
}
<section class="hero hero-compact mb-4">
    <span class="eyebrow">Three Grills · Bill for the whole visit</span>
    <h1>Visit #@Model.Visit.ReservationId</h1>
    <p class="lead mb-0">@Model.Visit.CustomerName · Table @Model.Visit.TableLabel · @Model.Visit.UnpaidOrders.Count unpaid order(s)</p>
</section>
<section class="tg-card h-auto mb-4">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (Model.Visit.UnpaidOrders.Count == 0)
    {
        <div class="alert alert-success">@BillingService.NothingToPayMessage</div>
    }
    else
    {
        foreach (var bill in Model.Visit.UnpaidOrders)
        {
            <partial name="~/Pages/Shared/_BillingLines.cshtml" model="bill" />
            if (bill.Status != OrderStatus.Completed)
            {
                <p class="text-warning small">Order #@bill.OrderId is still @bill.Status in the kitchen.</p>
            }
        }
        <p class="h4 text-end">Visit total: RM @Model.Visit.Total.ToString("N2")</p>

        if (!Model.Visit.ReadyToPay)
        {
            <div class="alert alert-warning">@BillingService.VisitNotReadyMessage</div>
        }
        else
        {
            <form method="post">
                <label asp-for="Input.Method" class="form-label"></label>
                <select asp-for="Input.Method" class="form-select mb-2" aria-describedby="visit-help">
                    <option value="">Choose a method</option>
                    <option value="@PaymentMethod.Cash">Cash</option>
                    <option value="@PaymentMethod.CardTerminal">Card terminal</option>
                    <option value="@PaymentMethod.EWallet">E-wallet</option>
                    <option value="@PaymentMethod.SimulatedOnline">Simulated online - DEMO ONLY</option>
                </select>
                <span asp-validation-for="Input.Method" class="text-danger"></span>
                <p id="visit-help" class="text-secondary">One payment covers every order above; the customer gets one receipt.</p>
                <button type="submit" class="btn btn-primary">Record payment for the whole visit</button>
            </form>
        }
    }
</section>
<a asp-page="Index">Back to billing</a>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
