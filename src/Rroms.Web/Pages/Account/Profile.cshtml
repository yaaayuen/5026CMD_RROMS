@page
@model Rroms.Web.Pages.Account.ProfileModel
@using Rroms.Web.Common
@using Rroms.Web.Models
@using Rroms.Web.Security
@{
	ViewData["Title"] = "My profile";
}

<a href="@User.GetHomePath()" class="d-inline-block mb-3">&larr; Back to dashboard</a>

<section class="hero hero-compact mb-4" aria-labelledby="profile-heading">
	<span class="hero-bubble one" aria-hidden="true"></span>
	<div class="position-relative">
		<span class="eyebrow">@Model.Details.RoleName</span>
		<h1 id="profile-heading" class="mb-1">My profile</h1>
		<p class="lead mb-0">Keep your details up to date so we can look after you.</p>
	</div>
</section>

<div class="row g-4">
	<div class="col-lg-8">
		<section class="tg-card h-auto" aria-labelledby="details-heading">
			<h2 id="details-heading" class="h4 mb-3">Your details</h2>

			<form method="post" novalidate>
				<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

				<div class="mb-3">
					<label asp-for="Input.FullName" class="form-label fw-semibold"></label>
					<input asp-for="Input.FullName" class="form-control" autocomplete="name" />
					<span asp-validation-for="Input.FullName" class="text-danger small"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Input.PhoneNumber" class="form-label fw-semibold"></label>
					<input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" />
					<span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
				</div>

				<button type="submit" class="btn btn-primary">Save changes</button>
			</form>
		</section>

		@if (Model.ShowDiningPreferences)
		{
			<section class="tg-card h-auto mt-4" aria-labelledby="dietary-heading">
				<h2 id="dietary-heading" class="h4 mb-1">Dietary preferences</h2>
				<p class="text-secondary mb-3">Tick what you don't eat and we'll leave those dishes out of your recommendations.</p>

				<div class="alert alert-warning small" role="note">
					<strong>Allergies:</strong> this filter helps you choose, but it is not an allergy guarantee.
					Kitchens handle many ingredients, so always tell our staff about allergies when you order.
				</div>

				<form method="post" asp-page-handler="Dietary">
					<fieldset class="mb-3">
						<legend class="small fw-semibold">I avoid dishes that contain</legend>
						<p class="form-text mt-0">Vegan? Tick <strong>Animal products</strong>.</p>
						<div class="row row-cols-1 row-cols-sm-3 g-2">
							@foreach (DietaryTag tag in Model.DietaryTags)
							{
								<div class="col">
									<div class="form-check">
										<input class="form-check-input" type="checkbox" name="AvoidTagIds" value="@tag.Id"
											   id="tag-@tag.Id" checked="@Model.AvoidTagIds.Contains(tag.Id)" />
										<label class="form-check-label" for="tag-@tag.Id">@tag.Name</label>
									</div>
								</div>
							}
						</div>
					</fieldset>

					<div class="form-check mb-3">
						<input asp-for="DietaryConsent" class="form-check-input" />
						<label asp-for="DietaryConsent" class="form-check-label small">
							I agree that @SiteInfo.RestaurantName may store these choices and use them to filter my dish
							recommendations. I can clear them at any time.
						</label>
					</div>

					<button type="submit" class="btn btn-primary">Save dietary preferences</button>
				</form>
			</section>
		}
	</div>

	<div class="col-lg-4">
		<aside class="tg-card h-auto" aria-labelledby="account-heading">
			<h2 id="account-heading" class="h5">Account</h2>
			<dl class="mb-3">
				<dt class="small text-secondary">Email (sign-in)</dt>
				<dd class="fw-semibold">@Model.Details.Email</dd>
				<dt class="small text-secondary">Role</dt>
				<dd><span class="role-chip">@Model.Details.RoleName</span></dd>
				<dt class="small text-secondary">Member since</dt>
				<dd>@MalaysiaTime.FromUtc(Model.Details.CreatedAtUtc).ToString("d MMM yyyy")</dd>
			</dl>
			<a class="btn btn-outline-primary w-100 mb-2" asp-page="/Account/ChangePassword">Change password</a>
			<a class="btn btn-outline-primary w-100" asp-page="/Account/TwoStep">
				Two-step sign-in: @(Model.Details.TwoStepEnabled ? "On" : "Off")
			</a>
		</aside>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}