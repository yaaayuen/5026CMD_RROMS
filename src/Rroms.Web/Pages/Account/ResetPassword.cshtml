@page
@model Rroms.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <a asp-page="/Account/ForgotPassword" asp-route-email="@Model.Input.Email" class="d-inline-block mb-3">&larr; Didn't get a code? Send another</a>

        <section class="tg-card auth-card" aria-labelledby="reset-heading">
            <span class="tg-icon gold"><partial name="_Icon" model='"lock"' /></span>
            <h1 id="reset-heading" class="h2 mb-1">Choose a new password</h1>
            <p class="text-secondary mb-4">Enter the 6-digit code from your email, then your new password.</p>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                    <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Code" class="form-label fw-semibold"></label>
                    @* one-time-code lets phones offer the code from the email automatically. *@
                    <input asp-for="Input.Code" class="form-control form-control-lg" inputmode="numeric" maxlength="6" autocomplete="one-time-code" autofocus />
                    <span asp-validation-for="Input.Code" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label fw-semibold"></label>
                    <input asp-for="Input.NewPassword" class="form-control form-control-lg" autocomplete="new-password" aria-describedby="new-password-rules" />
                    <div id="new-password-rules" class="form-text">At least 10 characters, with an upper-case letter, a lower-case letter, a number and a symbol.</div>
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Save new password</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
