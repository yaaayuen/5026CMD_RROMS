@page
@model Rroms.Web.Pages.Account.ChangePasswordModel
@{
	ViewData["Title"] = "Change password";
}

<div class="row justify-content-center">
	<div class="col-md-8 col-lg-5">
		<section class="tg-card auth-card" aria-labelledby="password-heading">
			<span class="tg-icon gold"><partial name="_Icon" model='"settings"' /></span>
			<h1 id="password-heading" class="h2 mb-1">Change password</h1>
			<p class="text-secondary mb-4">You'll stay signed in here. Other devices will be signed out.</p>

			<form method="post" novalidate>
				<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

				<div class="mb-3">
					<label asp-for="Input.CurrentPassword" class="form-label fw-semibold"></label>
					<input asp-for="Input.CurrentPassword" class="form-control form-control-lg" autocomplete="current-password" />
					<span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Input.NewPassword" class="form-label fw-semibold"></label>
					<input asp-for="Input.NewPassword" class="form-control form-control-lg" autocomplete="new-password" aria-describedby="new-password-rules" />
					<div id="new-password-rules" class="form-text">At least 10 characters, with an upper-case letter, a lower-case letter, a number and a symbol.</div>
					<span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
				</div>

				<div class="mb-4">
					<label asp-for="Input.ConfirmNewPassword" class="form-label fw-semibold"></label>
					<input asp-for="Input.ConfirmNewPassword" class="form-control form-control-lg" autocomplete="new-password" />
					<span asp-validation-for="Input.ConfirmNewPassword" class="text-danger small"></span>
				</div>

				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-primary flex-grow-1">Change password</button>
					<a class="btn btn-outline-primary" asp-page="/Account/Profile">Cancel</a>
				</div>
			</form>
		</section>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}