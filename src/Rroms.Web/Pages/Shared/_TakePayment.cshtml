@model decimal
@using Rroms.Web.Contracts
@using Rroms.Web.Common
@using System.Globalization
@{ var selected = ViewData.ModelState["Input.Method"]?.AttemptedValue ?? "Cash"; var cash = ViewData.ModelState["Input.CashReceived"]?.AttemptedValue ?? Model.ToString("0.00", CultureInfo.InvariantCulture); }
<form method="post" class="take-payment" data-total="@Model.ToString("0.00", CultureInfo.InvariantCulture)">
<h2 class="h4">Take payment</h2>
<p class="text-secondary">Confirm the payment was received before saving.</p>
<fieldset><legend class="h6">Payment method</legend><div class="payment-methods mb-3">
@foreach(var method in PaymentMethods.Supported) {
<label class="payment-method"><input type="radio" name="Input.Method" value="@method" checked="@(selected == method.ToString())" required /> <span aria-hidden="true">@(method == PaymentMethod.Cash ? "▣" : method == PaymentMethod.CardTerminal ? "▤" : method == PaymentMethod.EWallet ? "▧" : "◉")</span> <strong>@Money.Method(method)</strong><small>@(method == PaymentMethod.Cash ? "Count cash received" : "Confirm on your terminal")</small></label>
}
</div></fieldset>
<div class="cash-fields mb-3"><label for="cash-received" class="form-label">Cash received (RM)</label><input type="number" id="cash-received" name="Input.CashReceived" value="@cash" min="0" max="99999999.99" step="0.01" class="form-control" inputmode="decimal" /><div class="d-flex flex-wrap gap-2 my-2"><button type="button" class="btn btn-outline-primary btn-sm" data-cash="0">Exact</button><button type="button" class="btn btn-outline-primary btn-sm" data-cash="10">Next RM 10</button><button type="button" class="btn btn-outline-primary btn-sm" data-cash="50">Next RM 50</button></div><p class="alert alert-success mb-0" aria-live="polite">Change to give: <strong class="cash-change">—</strong></p></div>
<button type="submit" class="btn btn-primary w-100 payment-submit">Confirm @Money.Format(Model) paid</button>
<p class="small text-secondary mt-3 mb-0">The receipt opens after saving. Only an administrator can void a payment.</p>
<noscript><p>Select a method and enter cash received for cash payments. Change is checked and shown on the saved receipt.</p></noscript>
</form>
