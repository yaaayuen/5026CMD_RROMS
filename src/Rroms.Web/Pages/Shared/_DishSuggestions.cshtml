@model Rroms.Web.Models.ViewModels.DishSuggestionSection
@using Rroms.Web.Models.ViewModels
@{
	// The Menu page sets this: each suggestion then links down to the same dish's card on that page (id="dish-N").
	bool linkToDish = ViewData["SuggestionLinksToDish"] is true;
}
@if (Model.Items.Count > 0)
{
	<section class="mb-5" aria-labelledby="suggest-@Model.Key">
		<h2 id="suggest-@Model.Key" class="section-title h3 mb-3">@Model.Heading</h2>

		<div class="row g-3">
			@foreach (DishRecommendation item in Model.Items)
			{
				<div class="col-sm-6 col-lg-3">
					<article class="tg-card h-100 position-relative @(linkToDish ? "mn-suggest-link" : null)">
						<h3 class="h6 mb-1">
							@if (!string.IsNullOrEmpty(item.Dish.Code))
							{
								<span class="small fw-semibold text-secondary me-2">@item.Dish.Code</span>
							}
							@item.Dish.Name
						</h3>
						<p class="mb-1">
							@if (item.Dish.IsOfferActive)
							{
								<span class="text-decoration-line-through text-secondary">RM @item.Dish.NormalPrice.ToString("N2")</span>
							}
							<strong>RM @item.Dish.CurrentPrice.ToString("N2")</strong>
						</p>
						<p class="small text-secondary mb-0">@item.Reason</p>
						@if (linkToDish)
						{
							<a class="stretched-link js-jump-dish" href="#dish-@item.Dish.Id" aria-label="Show @item.Dish.Name on the menu"></a>
						}
					</article>
				</div>
			}
		</div>
	</section>
}
