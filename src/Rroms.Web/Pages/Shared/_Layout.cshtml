@inject Microsoft.AspNetCore.Identity.UserManager<Rroms.Web.Models.ApplicationUser> UserManager
@*
    Shared layout for every page (customer, staff, admin)
	@RenderBody() is where the page content is inserted.
*@
@{
	//Which area/page is being shown, so the matching nav link can be highlighted.
	string currentArea = ViewContext.RouteData.Values["area"] as string ?? string.Empty;
	string currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;

	bool isSignedIn = User.Identity?.IsAuthenticated == true;
	bool isAdministrator = User.IsInRole(RoleNames.Administrator);
	bool isStaff = User.IsInRole(RoleNames.Staff);
	bool isCustomer = User.IsInRole(RoleNames.Customer);

	//Label shown next to the user's name. Admin takes priority if the user has multiple roles.
	string roleLabel = string.Empty;
	if (isAdministrator)
	{
		roleLabel = RoleNames.Administrator;
	}
	else if (isStaff)
	{
		roleLabel = RoleNames.Staff;
	}
	else if (isCustomer)
	{
		roleLabel = RoleNames.Customer;
	}

	string pageTitle = ViewData["Title"] as string ?? "Welcome";
	//Name button in the navbar: a short role tag and the profile's full name (falls back to the e-mail).
	string displayName = User.Identity?.Name ?? string.Empty;
	if (isSignedIn)
	{
		Rroms.Web.Models.ApplicationUser? signedInUser = await UserManager.GetUserAsync(User);
		if (!string.IsNullOrWhiteSpace(signedInUser?.FullName))
		{
			displayName = signedInUser.FullName.Trim();
		}
	}
	string roleTag = roleLabel == RoleNames.Administrator ? "Admin" : roleLabel;

	// Gilded redesign: staff and admin pages open in the light "cream" look, every other page in the dark "noir" look.
	// This is only the starting look; the Dark mode button still switches it and remembers the visitor's choice (theme.js).
	bool isBackOffice = currentArea == "Admin" || currentArea == "Staff";
	string themeDefault = isBackOffice ? "light" : "dark";
	string bodyArea = currentArea == string.Empty ? "Public" : currentArea;
}
<!DOCTYPE html>
<html lang="en" data-theme-default="@themeDefault">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@pageTitle | @SiteInfo.RestaurantName</title>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

	@* Fonts (Gilded redesign): Playfair Display (headings), Jost (body), Pinyon Script (decorative words).
	   Served from wwwroot/lib/gilded-fonts, so no request goes to Google. *@
	<link rel="stylesheet" href="~/lib/gilded-fonts/fonts.css" asp-append-version="true" />

	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<script src="~/js/theme.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Styles", required: false)
</head>

@* data-area / data-page let site.css pick the banner photo for each page without editing every page. *@
<body data-area="@bodyArea" data-page="@currentPage">
	<a class="skip-link" href="#main-content">Skip to main content</a>

	<header>
		<nav class="navbar navbar-expand-xl site-navbar sticky-top" aria-label="Main navigation">
			<div class="container">
				<a class="brand navbar-brand" asp-area="" asp-page="/Index">
					<span class="brand-name">@SiteInfo.RestaurantName</span>
					<span class="brand-sub" aria-hidden="true">Kitchen · Grill</span>
				</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
						aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="main-nav">
					<ul class="navbar-nav me-auto mb-2 mb-xl-0 gap-xl-1">
						<li class="nav-item">
							@{
								bool homeActive = currentArea == string.Empty && currentPage == "/Index";
							}
							<a class="nav-link @(homeActive ? "active" : "")" aria-current="@(homeActive ? "page" : null)"
							   asp-area="" asp-page="/Index">Home</a>
						</li>
						@* Menu link for visitors and customers. Staff and administrators have their own menu pages. *@
						@if (!isSignedIn || isCustomer)
						{
							bool menuActive = currentArea == string.Empty && currentPage == "/Menu/Index";
							<li class="nav-item">
								<a class="nav-link @(menuActive ? "active" : "")" aria-current="@(menuActive ? "page" : null)"
								   asp-area="" asp-page="/Menu/Index">Menu</a>
							</li>
						}
						<li class="nav-item">
							@{
								bool newsActive = currentArea == string.Empty && currentPage == "/Announcements/Index";
							}
							<a class="nav-link @(newsActive ? "active" : "")" aria-current="@(newsActive ? "page" : null)"
							   asp-area="" asp-page="/Announcements/Index">News and offers</a>
						</li>

						<li class="nav-item">
							@* WL-1: public opening hours and contact, so guests can see them before signing in. *@
							@{
								bool visitActive = currentArea == string.Empty && currentPage == "/Visit/Index";
							}
							<a class="nav-link @(visitActive ? "active" : "")" aria-current="@(visitActive ? "page" : null)"
							   asp-area="" asp-page="/Visit/Index">Opening hours</a>
						</li>

						@* Each role only sees the link it is allowed to use.
						The server still checks permissions on every page Hiding links is for convenience, not security*@
						@if (isCustomer)
						{
							bool customerActive = currentArea == "Customer";
							<li class="nav-item">
								<a class="nav-link @(customerActive ? "active" : "")" aria-current="@(customerActive ? "page" : null)"
								   asp-area="Customer" asp-page="/Index">My dining</a>
							</li>
						}

						@if (isStaff)
						{
							bool staffActive = currentArea == "Staff";
							<li class="nav-item">
								<a class="nav-link @(staffActive ? "active" : "")" aria-current="@(staffActive ? "page" : null)"
								   asp-area="Staff" asp-page="/Index">Staff</a>
							</li>
						}

						@if (isAdministrator)
						{
							bool adminActive = currentArea == "Admin";
							<li class="nav-item">
								<a class="nav-link @(adminActive ? "active" : "")" aria-current="@(adminActive ? "page" : null)"
								   asp-area="Admin" asp-page="/Index">Administrator</a>
							</li>
						}
					</ul>
					<div class="d-flex flex-column flex-xl-row align-items-xl-center gap-2 ms-xl-2">
						<button type="button" class="theme-toggle align-self-start align-self-xl-center" data-theme-toggle aria-pressed="false" title="Switch between light and dark mode">
							@* Moon in dark mode, sun in light mode; site.css shows one of them from <html data-bs-theme>. *@
							<svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
							</svg>
							<svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="12" cy="12" r="4" />
								<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
							</svg>
							<span>Dark mode</span>
						</button>
						@if (isSignedIn)
						{
							@* Bell with unread badge (YY-6), rendered by a view component. *@
							@await Component.InvokeAsync("NotificationBell")

							@* One name button (role tag and name) instead of a separate role chip plus the full e-mail, so the bar fits at laptop width.
							   "Administrator" is shortened to "Admin" here; the tooltip keeps the full role. *@
							<a class="navbar-user-pill align-self-start align-self-xl-center" asp-area="" asp-page="/Account/Profile"
							   title="@(roleLabel == string.Empty ? $"My profile: {User.Identity?.Name}" : $"My profile: {User.Identity?.Name} ({roleLabel})")">
								@if (roleTag != string.Empty)
								{
									<span class="navbar-role">@roleTag</span>
								}
								<span class="navbar-user-name">@displayName</span>
							</a>

							@* Sign-out is a POST with an antiforgery token, so another site cannot log users out with a link. *@
							<form method="post" asp-area="" asp-page="/Account/Logout" class="d-inline">
								<button type="submit" class="btn btn-outline-primary btn-sm">Sign out</button>
							</form>
						}
						else
						{
							<a class="btn btn-outline-primary btn-sm" asp-area="" asp-page="/Account/Login">Sign in</a>
							<a class="btn btn-primary btn-sm" asp-area="" asp-page="/Account/Register">Create account</a>
						}
					</div>
				</div>
			</div>
		</nav>
	</header>

	<main id="main-content" class="site-main" tabindex="-1">
		<div class="container">
			<partial name="_StatusMessages" />
			@RenderBody()
		</div>
	</main>

	<footer class="site-footer">
		<div class="container">
			<div class="row gy-3 align-items-center">
				<div class="col-md-6">
					<div class="footer-brand">@SiteInfo.RestaurantName</div>
					<span class="footer-sub" aria-hidden="true">Kitchen · Grill</span>
					<small class="d-block mt-2">@SiteInfo.Tagline</small>
				</div>
				<div class="col-md-6 text-md-end">
					<small>&copy; @DateTime.UtcNow.Year @SiteInfo.RestaurantName. 5026CMD coursework project.</small>
				</div>
			</div>
		</div>
	</footer>

	@* Pop-up messages for live notifications are added here by notifications.js. *@
	<div id="notification-toasts" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@if (isSignedIn)
	{
		@* Live notifications only for signed-in users (YY-6). *@
		<script src="~/lib/microsoft-signalr/signalr.min.js"></script>
		<script src="~/js/notifications.js" asp-append-version="true"></script>
	}
	@if (!isAdministrator && !isStaff)
	{
		<partial name="_ChatWidget" />
		<script src="~/js/chatbot.js" asp-append-version="true"></script>
	}
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>