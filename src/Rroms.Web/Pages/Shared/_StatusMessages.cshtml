@*
    Shows one-off success or error messages after a redirect.
    A page sets TempData["StatusMessage"] or TempData["ErrorMessage"] before redirecting
    (the Post-Redirect-Get pattern), and the message appears once on the next page.
*@
@if (TempData["StatusMessage"] is string statusMessage)
{
	<div class="alert alert-success alert-dismissible fade show" role="status">
		@statusMessage
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
	<div class="alert alert-danger alert-dismissible fade show" role="alert">
		@errorMessage
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}