@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

@*
    Landing page (Gilded redesign).
    Accessibility: every photo that shows food has an alt text that describes the dish, so a screen reader
    (for example NVDA or Narrator, which can also read what is under the mouse) says what the picture shows.
    Purely decorative pictures (the dining-room background and the smoke) are CSS backgrounds or have alt="",
    so screen readers skip them instead of reading a file name.
*@

@* ----- Hero ----- *@
<section class="home-hero mb-5" aria-labelledby="hero-heading">
    <div class="home-hero-text">
        <span class="eyebrow">Western café-bistro</span>
        <h1 id="hero-heading" class="mb-3">Flame-grilled.<br />Freshly made.<br />Booked in <span class="script">seconds.</span></h1>
        <p class="lead mb-4">
            Reserve your table at @SiteInfo.RestaurantName, order from your seat and
            follow your food from the grill to your plate in real time.
        </p>
        <div class="d-flex flex-wrap gap-2">
            @if (User.IsInRole(RoleNames.Customer))
            {
                <a class="btn btn-gold btn-lg" asp-area="Customer" asp-page="/Index">Go to my dining</a>
            }
            else if (User.IsInRole(RoleNames.Administrator))
            {
                <a class="btn btn-gold btn-lg" asp-area="Admin" asp-page="/Index">Open the admin desk</a>
            }
            else if (User.IsInRole(RoleNames.Staff))
            {
                <a class="btn btn-gold btn-lg" asp-area="Staff" asp-page="/Index">Open the staff desk</a>
            }
            else
            {
                <a class="btn btn-gold btn-lg" asp-page="/Account/Register">Create an account to book</a>
                <a class="btn btn-outline-light btn-lg" asp-page="/Account/Login">Sign in</a>
            }
        </div>
    </div>
    <div class="home-hero-photo">
        <img src="~/images/gilded/steak-butter.webp"
             alt="Charcoal-grilled ribeye steak topped with melting garlic butter and a sprig of rosemary"
             width="900" height="900" fetchpriority="high" />
        <img class="home-smoke" src="~/images/gilded/smoke-a.webp" alt="" aria-hidden="true" />
    </div>
</section>

@* ----- What we serve ----- *@
<section class="home-signature mb-5" aria-labelledby="serve-heading">
    <div class="text-center mb-4 position-relative">
        <span class="eyebrow">Signature plates</span>
        <h2 id="serve-heading" class="section-title">What's on the grill</h2>
        <p class="section-subtitle mb-0">Three kitchens of flavour, one cosy bistro.</p>
    </div>

    <div class="row g-4 position-relative">
        <div class="col-md-4">
            <article class="home-dish">
                <img src="~/images/gilded/tbone.webp"
                     alt="T-bone steak on a dark board with roasted garlic and fresh rosemary"
                     width="600" height="600" loading="lazy" />
                <h3 class="h5">From the grill</h3>
                <p class="mb-0">Ribeye, lamb chops and chicken thighs cooked over open flame, served with house sauces.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="home-dish">
                <img src="~/images/gilded/big-breakfast.webp"
                     alt="All-day breakfast plate with two fried eggs, sausages, grilled tomatoes, baked beans and toasted bread"
                     width="600" height="600" loading="lazy" />
                <h3 class="h5">All-day brunch</h3>
                <p class="mb-0">Eggs Benedict, buttermilk pancakes and grilled sourdough sandwiches until closing.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="home-dish">
                <img src="~/images/gilded/tiramisu.webp"
                     alt="Slice of tiramisu dusted with cocoa powder, with coffee beans on the plate"
                     width="600" height="600" loading="lazy" />
                <h3 class="h5">Coffee &amp; desserts</h3>
                <p class="mb-0">Specialty coffee, basque burnt cheesecake and seasonal tarts to finish.</p>
            </article>
        </div>
    </div>
</section>

@* ----- How it works ----- *@
<section class="home-steps" aria-labelledby="how-heading">
    <div class="text-center mb-4">
        <span class="eyebrow">Your evening</span>
        <h2 id="how-heading" class="section-title">How it works</h2>
        <p class="section-subtitle">From booking to bill, all in one place.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="tg-card">
                <span class="step-number">1</span>
                <h3 class="h5">Book a table</h3>
                <p class="text-secondary mb-0">Pick a date, time and party size. Only free tables are shown, so there is no double booking.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="tg-card">
                <span class="step-number">2</span>
                <h3 class="h5">Order from your seat</h3>
                <p class="text-secondary mb-0">Browse the live menu, get suggestions you will like, and track your order as it cooks.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="tg-card">
                <span class="step-number">3</span>
                <h3 class="h5">Pay and rate</h3>
                <p class="text-secondary mb-0">Settle the bill, get an instant receipt and tell us how we did.</p>
            </div>
        </div>
    </div>
</section>
