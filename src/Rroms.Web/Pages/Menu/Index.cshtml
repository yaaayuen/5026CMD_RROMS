@page
@model Rroms.Web.Pages.Menu.IndexModel
@using Rroms.Web.Models
@using Rroms.Web.Models.ViewModels
@{
	ViewData["Title"] = "Our menu";

	// Only dishes that can be ordered get a quantity box. Their rows must be numbered 0, 1, 2, ... with no gaps,
	// because ASP.NET Core stops reading a list at the first missing number.
	List<MenuItemCard> orderable = Model.Dishes.Where(dish => dish.CanOrder).ToList();

	// What clicking a dish card on the plain menu does: "order" (start ordering for the booked table),
	// "book" (customer without a reservation that can order), "signin" (visitor), or null (staff and administrators).
	string? orderTarget = Model.OrderingOn ? null
		: !Model.IsSignedIn ? "signin"
		: !Model.IsCustomer ? null
		: Model.Selected != null ? "order" : "book";

	OrderBarView barView = new OrderBarView
	{
		AddingTo = Model.Selected == null ? null : Model.Describe(Model.Selected),
		MaxOrderNoteLength = Model.MaxOrderNoteLength,
		Notes = Model.Notes
	};
}

@if (Model.OrderingOn)
{
	<partial name="_OrderStyles" />
}

<style>
	.mn-ph { height: 12rem; margin-bottom: 1rem; border-radius: var(--bs-border-radius); background: var(--tg-gradient); display: grid; place-items: center; font-family: var(--tg-font-heading); font-size: 3rem; font-weight: 800; color: rgba(255, 255, 255, 0.85); }
	.promo-banner { background: linear-gradient(135deg, #d9b66e, #a7803a); color: #14110d; border-radius: 14px; padding: .85rem 1.25rem; font-weight: 700; }
</style>

<section class="hero hero-compact mb-4" aria-labelledby="menu-heading">
	<span class="hero-bubble one" aria-hidden="true"></span>
	<div class="position-relative">
		<span class="eyebrow">Three Grills</span>
		<h1 id="menu-heading" class="mb-1">Our menu</h1>
		<p class="lead mb-0">Fresh from the grill. Search by name, pick a category or set a price range.</p>
	</div>
</section>

@foreach (string promotion in Model.Promotions)
{
	<div class="promo-banner mb-3" role="status">&#127881; @promotion</div>
}

@if (!Model.IsSignedIn)
{
	<section class="tg-card h-auto mb-4" aria-label="Order from the menu">
		<p class="mb-0">
			Hungry? <a class="btn btn-primary ms-2" href="/Account/Login?returnUrl=%2FMenu">Sign in to order</a>
		</p>
	</section>
}
else if (Model.IsCustomer && Model.Selected == null)
{
	<section class="tg-card h-auto mb-4" aria-label="Order from the menu">
		<p class="mb-0">
			You can order once you have a confirmed reservation.
			<a class="btn btn-primary ms-2" asp-area="Customer" asp-page="/Reservations/Index">Book a table to order</a>
		</p>
	</section>
}
else if (Model.IsCustomer && !Model.OrderingOn)
{
	<section class="tg-card h-auto mb-4" aria-label="Order from the menu">
		<p class="mb-0">
			You have a reservation, so you can order from this page.
			<a class="btn btn-primary ms-2" asp-page="/Menu/Index" asp-route-order="1" asp-route-reservationId="@Model.Selected!.Id">Start ordering</a>
		</p>
	</section>
}
else if (Model.OrderingOn)
{
	<section class="tg-card h-auto mb-4 @(Model.StartDishId != null ? "mn-ordering-just-started" : null)" id="orderingCard" aria-label="Ordering">
		<div class="ox-strip">
			<label for="orderingFor" class="fw-semibold mb-0">Ordering for</label>
			<select id="orderingFor" class="form-select" style="max-width: 24rem;">
				@foreach (OrderableReservation reservation in Model.OrderableReservations)
				{
					<option value="@reservation.Id" selected="@(reservation.Id == Model.Selected!.Id)">@Model.Describe(reservation)</option>
				}
			</select>
			<a class="btn btn-outline-secondary ms-auto" asp-page="/Menu/Index">Stop ordering</a>
		</div>
		@if (Model.StartDishId is int startDish)
		{
			<p class="mn-added-note mt-2 mb-0" role="status">
				&#10003; 1 &times; @Model.Dishes.First(d => d.Id == startDish).Name added to your order for the table above.
				Add more dishes below, or change the table if you have another booking.
			</p>
		}
		<p class="small text-secondary mt-2 mb-0" id="switchNote" hidden>
			Your picks stay in your order when you change reservation. They will be added to the one chosen above.
		</p>
	</section>
}

@* Plain menu: the filter stays at the top of the screen while the dish list scrolls (site.css .mn-filter-sticky).
   Not in the ordering view, which already keeps its category chips at the top. *@
<section class="tg-card h-auto mb-4 @(Model.OrderingOn ? null : "mn-filter-sticky")" aria-labelledby="filter-heading">
	<h2 id="filter-heading" class="h5 mb-3">Find a dish</h2>

	<form method="get" class="row g-3 align-items-end">
		@if (Model.OrderingOn)
		{
			<input type="hidden" name="order" value="1" />
			<input type="hidden" name="reservationId" id="filterReservationId" value="@Model.Selected!.Id" />
		}
		<div class="col-md-4">
			<label for="menuSearch" class="form-label fw-semibold">Search</label>
			<input id="menuSearch" name="q" type="search" class="form-control" value="@Model.SearchText" placeholder="e.g. burger or PO1" />
		</div>
		<div class="col-md-3">
			<label for="menuCategory" class="form-label fw-semibold">Category</label>
			<select id="menuCategory" name="categoryId" class="form-select">
				<option value="">All categories</option>
				@foreach (MenuCategory category in Model.Categories)
				{
					<option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
				}
			</select>
		</div>
		<div class="col-6 col-md-2">
			<label for="menuMinPrice" class="form-label fw-semibold">Min price (RM)</label>
			<input id="menuMinPrice" name="minPrice" type="number" min="0" step="0.01" class="form-control" value="@Model.MinPrice" />
		</div>
		<div class="col-6 col-md-2">
			<label for="menuMaxPrice" class="form-label fw-semibold">Max price (RM)</label>
			<input id="menuMaxPrice" name="maxPrice" type="number" min="0" step="0.01" class="form-control" value="@Model.MaxPrice" />
		</div>
		<div class="col-12 col-md">
			<fieldset>
				<legend class="form-label fw-semibold fs-6 mb-1">Hide dishes that contain</legend>
				@foreach (DietaryTag tag in Model.TagChoices)
				{
					<div class="form-check form-check-inline">
						<input id="menuHide@(tag.Id)" name="hide" type="checkbox" value="@tag.Id" class="form-check-input" checked="@Model.HideTagIds.Contains(tag.Id)" />
						<label for="menuHide@(tag.Id)" class="form-check-label">@tag.Name</label>
					</div>
				}
			</fieldset>
		</div>
		@* Same row as the dietary boxes, at the right, so the box stays short. *@
		<div class="col-12 col-md-auto d-grid">
			<button type="submit" class="btn btn-primary px-4">Filter</button>
		</div>
	</form>

	@if (Model.HasFilters)
	{
		<a class="d-inline-block mt-3" asp-page="/Menu/Index">Show the whole menu</a>
	}
</section>

@{ ViewData["SuggestionLinksToDish"] = true; }
<partial name="_DishSuggestions" model="Model.Popular" />

@if (Model.Dishes.Count == 0)
{
	<p class="text-secondary" role="status">No dishes match. Try a different search or filter.</p>
}
else if (Model.OrderingOn)
{
	<div class="ox-page">
		<form method="post" asp-page-handler="PlaceOrder" id="orderForm" novalidate>
			<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
			<input type="hidden" name="reservationId" id="orderReservationId" value="@Model.Selected!.Id" />

			@if (Model.AvoidedTagNames.Count > 0)
			{
				<div class="ox-diet-banner" role="note">
					<strong>Your profile avoids: @string.Join(", ", Model.AvoidedTagNames.OrderBy(name => name))</strong>
					<span>Dishes that contain these are marked with a warning. This is a guide only, so please tell our staff about any allergy.</span>
					<a href="/Account/Profile">Change my dietary preferences</a>
				</div>
			}

			@foreach (IGrouping<string, MenuItemCard> group in Model.Dishes.GroupBy(dish => dish.CategoryName))
			{
				<section class="mb-4" aria-label="@group.Key">
					<h2 class="section-title h3 mb-3">@group.Key</h2>

					<div class="row g-3">
						@foreach (MenuItemCard dish in group)
						{
							OrderDishView dishView = new OrderDishView
							{
								Dish = dish,
								Row = orderable.IndexOf(dish),
								Avoided = Model.AvoidedIn(dish),
								Quantity = Model.QuantityFor(dish.Id),
								Note = Model.NoteFor(dish.Id),
								MaxQuantity = Model.MaxQuantity,
								MaxLineNoteLength = Model.MaxLineNoteLength,
								ShowAlreadyOrdered = true,
								AlreadyOrdered = Model.AlreadyOrdered(Model.Selected!.Id, dish.Id),
								OrderedByReservation = Model.AlreadyOrderedText(dish.Id)
							};

							<div class="col-sm-6 col-lg-4">
								<partial name="_OrderDish" model="dishView" />
							</div>
						}
					</div>
				</section>
			}

			<partial name="_OrderBar" model="barView" />
		</form>
	</div>
}
else
{
	@foreach (IGrouping<string, MenuItemCard> group in Model.Dishes.GroupBy(dish => dish.CategoryName))
	{
		<section class="mb-5" aria-label="@group.Key">
			<h2 class="section-title h3 mb-3">@group.Key</h2>

			<div class="row g-4">
				@foreach (MenuItemCard dish in group)
				{
					<div class="col-sm-6 col-lg-4">
						<article id="dish-@dish.Id" class="tg-card h-100 position-relative @(dish.IsAvailable ? "" : "opacity-75") @(dish.CanOrder && orderTarget != null ? "mn-orderable" : null)">
							@if (dish.PhotoUrl != null)
							{
								<img src="@dish.PhotoUrl" alt="Photo of @dish.Name" class="rounded mb-3 w-100" style="object-fit: cover; height: 12rem;" />
							}
							else
							{
								<div class="mn-ph" aria-hidden="true">@(string.IsNullOrEmpty(dish.Name) ? "?" : dish.Name.Substring(0, 1).ToUpperInvariant())</div>
							}

							<h3 class="h5">
								@if (!string.IsNullOrEmpty(dish.Code))
								{
									<span class="small fw-semibold text-secondary me-2">@dish.Code</span>
								}
								@dish.Name
							</h3>
							<p class="text-secondary">@dish.Description</p>

							<p class="mb-1">
								@if (dish.IsOfferActive)
								{
									<span class="text-decoration-line-through text-secondary">RM @dish.NormalPrice.ToString("N2")</span>
									<strong class="fs-5">RM @dish.CurrentPrice.ToString("N2")</strong>
									<span class="badge text-bg-warning">@dish.OfferBadge</span>
								}
								else
								{
									<strong class="fs-5">RM @dish.CurrentPrice.ToString("N2")</strong>
								}
							</p>

							@if (dish.IsOfferActive && dish.OfferEndsAtUtc.HasValue)
							{
								<p class="small text-secondary mb-2">Offer until @Model.FormatOfferEnd(dish.OfferEndsAtUtc.Value)</p>
							}

							@if (!string.IsNullOrEmpty(dish.OfferNote))
							{
								<p class="small text-secondary mb-2">@dish.OfferNote</p>
							}

							@if (dish.IsAvailable)
							{
								<span class="badge text-bg-success">Available</span>
							}
							else
							{
								<span class="badge text-bg-secondary">Unavailable</span>
							}

							@foreach (string tagName in dish.DietaryTags)
							{
								<span class="badge text-bg-light border">@tagName</span>
							}

							@* Click anywhere on the card to order it (customers and visitors only; staff see the plain menu). *@
							@if (dish.CanOrder && orderTarget == "order")
							{
								<a class="stretched-link mn-order-link" href="@Model.OrderLinkFor(dish.Id)" aria-label="Order @dish.Name"><span class="mn-order-hint" aria-hidden="true">Tap to order</span></a>
							}
							else if (dish.CanOrder && orderTarget != null)
							{
								<a class="stretched-link mn-order-link js-order-prompt" href="@(orderTarget == "book" ? "/Customer/Reservations/Book" : "/Account/Login?returnUrl=%2FMenu")" aria-label="Order @dish.Name" aria-haspopup="dialog"><span class="mn-order-hint" aria-hidden="true">Tap to order</span></a>
							}
						</article>
					</div>
				}
			</div>
		</section>
	}
}

@if (orderTarget is "book" or "signin")
{
	<dialog id="orderPrompt" class="tg-card mn-order-prompt" aria-labelledby="orderPromptTitle">
		@if (orderTarget == "book")
		{
			<h2 id="orderPromptTitle" class="h4">Book a table first</h2>
			<p>You can order food once you have a reservation. Book a table, then come back to the menu to order.</p>
			<div class="d-flex flex-wrap gap-2">
				<a class="btn btn-primary" href="/Customer/Reservations/Book">Book a table</a>
				<button type="button" class="btn btn-outline-secondary" data-close-prompt>Keep browsing</button>
			</div>
		}
		else
		{
			<h2 id="orderPromptTitle" class="h4">Sign in to order</h2>
			<p>Sign in, or create a free account, to book a table and order from the menu.</p>
			<div class="d-flex flex-wrap gap-2">
				<a class="btn btn-primary" href="/Account/Login?returnUrl=%2FMenu">Sign in</a>
				<a class="btn btn-outline-primary" href="/Account/Register">Create an account</a>
				<button type="button" class="btn btn-outline-secondary" data-close-prompt>Keep browsing</button>
			</div>
		}
	</dialog>
}

@* Menu page only: back to the top of the long dish list. Sits just above the "Ask Three Grills" chat button. *@
<button type="button" id="scrollTopButton" class="mn-scroll-top @(Model.OrderingOn ? "is-ordering" : null)" title="Scroll to top" aria-label="Scroll to top">
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 19V5M5 12l7-7 7 7" />
	</svg>
</button>

@section Scripts {
	<script>
		(function () {
			var button = document.getElementById('scrollTopButton');
			if (!button) { return; }
			var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Only show it once the visitor has scrolled down a screen or so.
			function update() { button.classList.toggle('is-visible', window.scrollY > 600); }
			window.addEventListener('scroll', update, { passive: true });
			update();

			button.addEventListener('click', function () {
				window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
			});
		})();
	</script>
	@if (!Model.OrderingOn && Model.Popular.Items.Count > 0)
	{
		<script>
			(function () {
				// "Popular this month": scroll down to the dish's card and highlight it for a moment.
				document.querySelectorAll('.js-jump-dish').forEach(function (link) {
					link.addEventListener('click', function (event) {
						var card = document.querySelector(link.getAttribute('href'));
						if (!card) { return; }
						event.preventDefault();
						card.scrollIntoView({ behavior: 'smooth', block: 'center' });
						card.classList.remove('mn-jump-highlight');
						void card.offsetWidth; // restart the animation when the same dish is clicked again
						card.classList.add('mn-jump-highlight');
						setTimeout(function () { card.classList.remove('mn-jump-highlight'); }, 2600);
						try { window.history.replaceState(null, '', link.getAttribute('href')); } catch (e) { }
					});
				});
			})();
		</script>
	}
	@if (orderTarget is "book" or "signin")
	{
		<script>
			(function () {
				var dialog = document.getElementById('orderPrompt');
				// Without <dialog> support the links simply open the booking or sign-in page.
				if (!dialog || typeof dialog.showModal !== 'function') { return; }

				document.querySelectorAll('.js-order-prompt').forEach(function (link) {
					link.addEventListener('click', function (event) {
						event.preventDefault();
						dialog.showModal();
					});
				});
				dialog.querySelector('[data-close-prompt]').addEventListener('click', function () { dialog.close(); });
				// A click on the dark backdrop closes it too.
				dialog.addEventListener('click', function (event) { if (event.target === dialog) { dialog.close(); } });
			})();
		</script>
	}
	@if (Model.OrderingOn && Model.StartDishId != null)
	{
		<script>
			(function () {
				// Came from a dish card: bring that dish into view and show which table the order is for.
				var card = document.querySelector('.ox-dish[data-dish="@Model.StartDishId"]');
				if (!card) { return; }
				card.classList.add('mn-just-picked');
				var ordering = document.getElementById('orderingCard');
				if (ordering) { ordering.scrollIntoView({ block: 'start' }); }
				setTimeout(function () {
					card.classList.remove('mn-just-picked');
					if (ordering) { ordering.classList.remove('mn-ordering-just-started'); }
				}, 4000);
				// Clean the address so a refresh does not add the dish again.
				try {
					var url = new URL(window.location.href);
					url.searchParams.delete('dish');
					window.history.replaceState(null, '', url);
				} catch (e) { }
			})();
		</script>
	}
	@if (Model.OrderingOn)
	{
		<partial name="_OrderScripts" />
		<script>
			(function () {
				var select = document.getElementById('orderingFor');

				if (!select) {
					return;
				}

				var hidden = document.getElementById('orderReservationId');
				var filter = document.getElementById('filterReservationId');
				var adding = document.getElementById('addingToText');
				var note = document.getElementById('switchNote');

				function countFor(text, reservationId) {
					var parts = (text || '').split('|');

					for (var i = 0; i < parts.length; i++) {
						var pair = parts[i].split(':');

						if (pair[0] === String(reservationId)) {
							return parseInt(pair[1], 10) || 0;
						}
					}

					return 0;
				}

				// Switching reservation keeps what the customer has picked; only the target and the badges change.
				select.addEventListener('change', function () {
					var id = select.value;
					if (hidden) {
						hidden.value = id;
					}

					if (filter) {
						filter.value = id;
					}

					if (adding) {
						adding.textContent = select.options[select.selectedIndex].text;
					}

					[].slice.call(document.querySelectorAll('[data-ordered-badge]')).forEach(function (badge) {
						var n = countFor(badge.dataset.orderedBadge, id);
						badge.hidden = n === 0;
						badge.textContent = n > 0 ? badge.dataset.label + n : '';
					});

					var picked = [].slice.call(document.querySelectorAll('input[data-price]')).some(function (input) {
						return (parseInt(input.value, 10) || 0) > 0;
					});

					if (note) {
						note.hidden = !picked;
					}

					try {
						var url = new URL(window.location.href);
						url.searchParams.set('reservationId', id);
						window.history.replaceState(null, '', url);
					} catch (e) { }
				});
			})();
		</script>
	}
}
